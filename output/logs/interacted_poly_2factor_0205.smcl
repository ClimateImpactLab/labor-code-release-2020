{smcl}
{com}{sf}{ul off}{txt}{.-}
      name:  {res}<unnamed>
       {txt}log:  {res}/project/cil/home_dirs/nishkasharma/repos/labor-code-release-2020/logs/interacted_poly_2factor_0205.smcl
  {txt}log type:  {res}smcl
 {txt}opened on:  {res} 5 Feb 2026, 18:32:51
{txt}
{com}. 
. * select dataset and output folder
. gl dataset      "${c -(}ROOT_INT_DATA{c )-}/regression_ready_data/labor_dataset_polynomials_nochn_tmax_chn_prev_week_no_ll_0_agnonag_272841_0203.dta"
{txt}
{com}. loc reg_folder "${c -(}DIR_OUTPUT{c )-}/interacted_poly_2factor/ster"
{txt}
{com}. 
. * other selections
. gl test_code "no"
{txt}
{com}. gl reg_list 2_factor
{txt}
{com}. loc fe fe_adm0_wk
{txt}
{com}. local t_version "tmax"
{txt}
{com}. 
. * Note on weights: 
. *   run regression 1_factor with mixed weights (see line 131, 144,)
. *   run regression 2_factor with rep_unit_year_sample_wgt
. 
. * ---------- CHOOSE WHICH RISK DEFINITION TO USE ---------- 
. global risk_def "high_risk"
{txt}
{com}. * --------------------------------------------------------
. 
. ********************
. *  RUN REGRESSION
. ********************
. 
. * cycle through each of the two regressions
. foreach reg in $reg_list {c -(}
{txt}  2{com}.         forval N_order=2(1)4 {c -(}
{txt}  3{com}.                     di "`reg_list'"
{txt}  4{com}.                         
.                     use $dataset, clear
{txt}  5{com}.                     drop if iso == "GBR" & year == 1984 & month == 1 & day == 2
{txt}  6{com}. 
.                     * if test code mode is on, take a random sample
.                     if "${c -(}test_code{c )-}"=="yes" {c -(}
{txt}  7{com}.                         sample 0.1
{txt}  8{com}.                     {c )-}
{txt}  9{com}. 
.                     * only include non-zero observations
.                     keep if mins_worked > 0
{txt} 10{com}. 
.                     * generate regression variables
.                     gen_controls_and_FEs
{txt} 11{com}.                     gen_treatment_polynomials `N_order' tmax this_week 1
{txt} 12{com}. 
.                     * ---------- DEFINE risk_level FROM CHOSEN SOURCE ----------
.                     cap drop risk_level
{txt} 13{com}.                     gen risk_level = .
{txt} 14{com}.                     replace risk_level = high_risk_old if "${c -(}risk_def{c )-}"=="high_risk_old"
{txt} 15{com}.                     replace risk_level = high_risk if "${c -(}risk_def{c )-}"=="high_risk"
{txt} 16{com}.                     replace risk_level = sector if "${c -(}risk_def{c )-}"=="sector"
{txt} 17{com}.                     replace risk_level = occup_code if "${c -(}risk_def{c )-}"=="occup_code"
{txt} 18{com}.                     * ----------------------------------------------------------
. 
.                     * generate variables for the pooled regression to get the correct coeffs for LR group
.                     gen low_risk = 1 - risk_level
{txt} 19{com}. //                  ******* will be updated as needed 
. //                  if "`reg'" == "1_factor" loc reg_treatment tmax_rcspl_3kn_t0_lr* tmax_rcspl_3kn_t1_lr* tmax_rcspl_3kn_t0_hr* tmax_rcspl_3kn_t1_hr*
. //
. //                  *** This will give you un-useable estimate for LR
. //                  *if "`reg'" == "1_factor" loc reg_treatment (${c -(}vars_T_splines{c )-} ${c -(}vars_T_x_gdp_splines{c )-})##i.risk_level
.                   
.                     else if "`reg'" == "2_factor" loc reg_treatment (${c -(}vars_T_polynomials{c )-} ${c -(}vars_T_x_gdp_polynomials{c )-} ${c -(}vars_T_x_lr_`t_version'_polynomials{c )-})##i.risk_level
{txt} 20{com}.                     else di in red "bad reg specification -> pick '1 factor' or '2 factor'"
{txt} 21{com}.                     di "`reg_treatment'"
{txt} 22{com}. 
.                     * both regressions have interacted controls
.                     local reg_control (${c -(}usual_controls{c )-})##i.risk_level
{txt} 23{com}.                     di "`reg_control'"
{txt} 24{com}.                     
.                     * interact each fixed effect with the risk binary
.                     local reg_fe ""                    
{txt} 25{com}.                     foreach f in $`fe' {c -(}
{txt} 26{com}.                         local reg_fe `reg_fe' `f'#risk_level
{txt} 27{com}.                     {c )-}
{txt} 28{com}.                 * -------------------------------------------------------------------------------------------------------
.                     * set the ster file name and the notes to be included
.                     local ster_name "`reg_folder'/interacted_polynomials_`reg'_`N_order'.ster"
{txt} 29{com}.                     local spec_desc "polynomial, tmax, differentiated treatment with lr interaction, fe = $fe, reg_type = `reg'"
{txt} 30{com}. 
.                 * -------------------------------------------------------------------------------------------------------
.                     * set the regression weight
.                     *replace risk_adj_sample_wgt = rep_unit_year_sample_wgt if risk_level == 1
.                     loc weight "rep_unit_year_sample_wgt"
{txt} 31{com}. 
.                     di "reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)"
{txt} 32{com}.                     reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)
{txt} 33{com}. 
.                     * count regression N by risk
.                     gen included = e(sample)
{txt} 34{com}.                     count if included == 1 & risk_level == 0
{txt} 35{com}.                     estadd scalar low_N = `r(N)'
{txt} 36{com}.                     count if included == 1 & risk_level == 1
{txt} 37{com}.                     estadd scalar high_N = `r(N)'
{txt} 38{com}.                  *   count if included == 1 & risk_level == 2
.                   *  estadd scalar nonag_N = `r(N)'
. 
.                     estimates notes: "`spec_desc' representative unit-year weights"
{txt} 39{com}.                     estimates save "`ster_name'", replace
{txt} 40{com}. 
.                     di "COMPLETED: `reg' regression."
{txt} 41{com}.         {c )-}
{txt} 42{com}. {c )-}

