  =void confirm_wildcards_link(struct rename_patterndf scalar oldp, real scalar j_old,
  =                            struct rename_patterndf scalar newp, real scalar j_new)
  =        real scalar  tt_old, tt_new
  =        if (tt_new == (3)) return
