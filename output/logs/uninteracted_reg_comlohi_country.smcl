      - if ("`header'" == "") reghdfe_header
      = if ("" == "") reghdfe_header
        {hline 61} begin reghdfe_header {hline}
        - if !c(noisily) exit
        - tempname left right
        - .`left' = {c -(}{c )-}
        = .__000003 = {c -(}{c )-}
        - .`right' = {c -(}{c )-}
        = .__000004 = {c -(}{c )-}
        - local width 78
        - local colwidths 1 30 51 67
        - local i 0
        - foreach c of local colwidths {c -(}
        - local ++i
        - local c`i' `c'
        = local c1 1
        - local C`i' _col(`c')
        = local C1 _col(1)
        - {c )-}
        - local ++i
        - local c`i' `c'
        = local c2 30
        - local C`i' _col(`c')
        = local C2 _col(30)
        - {c )-}
        - local ++i
        - local c`i' `c'
        = local c3 51
        - local C`i' _col(`c')
        = local C3 _col(51)
        - {c )-}
        - local ++i
        - local c`i' `c'
        = local c4 67
        - local C`i' _col(`c')
        = local C4 _col(67)
        - {c )-}
        - local c2wfmt 10
        - local c4wfmt 10
        - local max_len_title = `c3' - 2
        = local max_len_title = 51 - 2
        - local c4wfmt1 = `c4wfmt' + 1
        = local c4wfmt1 = 10 + 1
        - local title `"`e(title)'"'
        = local title `"HDFE Linear regression"'
        - local title2 `"`e(title2)'"'
        = local title2 `"Absorbing 1 HDFE group"'
        - local title3 `"`e(title3)'"'
        = local title3 `"Statistics robust to heteroskedasticity"'
        - local title4 `"`e(title4)'"'
        = local title4 `""'
        - local title5 `"`e(title5)'"'
        = local title5 `""'
        - .`right'.Arrpush `C3' "Number of obs" `C4' "= " as res %`c4wfmt'.0fc e(N)
        = .__000004.Arrpush _col(51) "Number of obs" _col(67) "= " as res %10.0fc e(N)
        - if `"`e(chi2)'"' != "" | "`e(df_r)'" == "" {c -(}
        = if `""' != "" | "587" == "" {c -(}
          Chi2test `right' `C3' `C4' `c4wfmt'
          {c )-}
        - else {c -(}
        - Ftest `right' `C3' `C4' `c4wfmt'
        = Ftest __000004 _col(51) _col(67) 10
          {hline 53} begin reghdfe_header.Ftest {hline}
          - args right C3 C4 c4wfmt is_svy
          - local df = e(df_r)
          - if !missing(e(F)) {c -(}
          - .`right'.Arrpush `C3' "F(" as res %4.0f e(df_m) as txt "," as res %7.0f `df' as txt ")" `C4' "= " as res %`c4wfmt'.2f e(F)
          = .__000004.Arrpush _col(51) "F(" as res %4.0f e(df_m) as txt "," as res %7.0f 587 as txt ")" _col(67) "= " as res %10.2f e(F)
          - .`right'.Arrpush `C3' "Prob > F" `C4' "= " as res %`c4wfmt'.4f Ftail(e(df_m),`df',e(F))
          = .__000004.Arrpush _col(51) "Prob > F" _col(67) "= " as res %10.4f Ftail(e(df_m),587,e(F))
          - {c )-}
          - else {c -(}
            local dfm_l : di %4.0f e(df_m)
            local dfm_l2: di %7.0f `df'
            local j_robust "{c -(}help j_robustsingular##|_new:F(`dfm_l',`dfm_l2'){c )-}"
            .`right'.Arrpush `C3' "`j_robust'" as txt `C4' "= " as result %`c4wfmt's "."
            .`right'.Arrpush `C3' "Prob > F" `C4' "= " as res %`c4wfmt's "."
            {c )-}
          {hline 55} end reghdfe_header.Ftest {hline}
        - {c )-}
        - if !missing(e(r2)) {c -(}
        - .`right'.Arrpush `C3' "R-squared" `C4' "= " as res %`c4wfmt'.4f e(r2)
        = .__000004.Arrpush _col(51) "R-squared" _col(67) "= " as res %10.4f e(r2)
        - {c )-}
        - if !missing(e(r2_a)) {c -(}
        - .`right'.Arrpush `C3' "Adj R-squared" `C4' "= " as res %`c4wfmt'.4f e(r2_a)
        = .__000004.Arrpush _col(51) "Adj R-squared" _col(67) "= " as res %10.4f e(r2_a)
        - {c )-}
