        - if "`eqselect'" == "" {c -(}
        = if "" == "" {c -(}
        - if "`eformdi'"!="" & ("`e(cmd)'"!="gnbreg" | "`e(prefix)'"=="svy") {c -(}
        = if ""!="" & ("reghdfe"!="gnbreg" | ""=="svy") {c -(}
          local k_eform `e(k_eform)'
          if ("`k_eform'"=="") {c -(}
          local k_eform = 1
          {c )-}
          local k_eq `e(k_eq)'
          if ("`k_eq'"=="") {c -(}
          local k_eq = 1
          {c )-}
          if (`k_eform'<`k_eq' & `k_eform') {c -(}
          if ("`e(cmd2)'" == "stintreg" | "`e(cmd2)'" == "streg") & ("`e(cmd)'" == "weibull" | "`e(cmd)'" == "gompertz") {c -(}
          {c )-}
          else {c -(}
          _eform_multeq_note efnote : `k_eform'
          di as txt "`efnote'"
          {c )-}
          {c )-}
          {c )-}
        - if (`"`eformdi'"'!="" & "`e(noconstant)'"=="0" & `"`eform_cons_ti'"'!="" & "`e(consonly)'"!="1") {c -(}
        = if (`""'!="" & ""=="0" & `""'!="" & ""!="1") {c -(}
          if ("`e(cmd)'"=="asclogit" | "`e(cmd)'"=="cmclogit" | "`e(cmd)'"=="cmmixlogit" | "`e(cmd)'"=="cmxtmixlogit" ) {c -(}
          local asvar = `"`e(ranvars)'`e(fixvars)'`e(indvars)'"' != ""
          if `"`e(casevars)'"' != "" & `asvar' {c -(}
          local note1 "Exponentiated coefficients represent odds ratios for "
          local note2 "alternative-specific variables (first equation) and "
          local note3 "{c -(}help j_cmrisk##|_new:relative-risk ratios{c )-} "
          local note4 "for case-specific variables."
          di as txt "{c -(}p 0 6 2{c )-}Note: `note1'`note2'`note3'`note4'{c -(}p_end{c )-}"
          {c )-}
          {c )-}
          if "`eform_cons_ti'" == "Inc. Rate" {c -(}
          local eform_cons_note "incidence rate"
          {c )-}
          else if "`eform_cons_ti'" == "Rel. Risk" {c -(}
          local eform_cons_note "relative risk"
          {c )-}
          else if "`eform_cons_ti'" == "Health" {c -(}
          local eform_cons_note "health (probability of no disease)"
          {c )-}
          else {c -(}
          local eform_cons_note = strlower(`"`eform_cons_ti'"')
          {c )-}
          local eform_cons_note "baseline `eform_cons_note'"
          if ("`e(cmd2)'"=="") {c -(}
          local cmd `e(cmd)'
