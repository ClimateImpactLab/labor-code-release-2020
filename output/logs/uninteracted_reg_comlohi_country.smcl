  =real scalar match_simplification(struct rename_matchdf scalar m, struct rename_peldf rowvector ellist)
  =        real scalar      mr
  =        while ((m.i1 >m.i0 & m.j1> m.j0)) {c -(}
  =                mr = match_fixed(m, ellist, 1)
