r; t=15.93 21:38:40

{com}. restore
{txt}r; t=0.00 21:38:40

{com}. 
. *------------------------------------------------------------
. * loop over countries
. *------------------------------------------------------------
. foreach C of local countries {c -(}
{txt}  2{com}. 
.     di as txt "-----------------------------"
{txt}  3{com}.     di as txt "Running iso = `C'"
{txt}  4{com}.     di as txt "-----------------------------"
{txt}  5{com}. 
.     use "${c -(}dataset{c )-}", clear
{txt}  6{com}.     keep if iso == "`C'"
{txt}  7{com}.     quietly count
{txt}  8{com}.     if (r(N) < `minN') {c -(}
{txt}  9{com}.         di as txt "Skip `C' (N=" r(N) " < `minN')"
{txt} 10{com}.         continue
{txt} 11{com}.     {c )-}
{txt} 12{com}. 
.     * ---- BEGIN exact inner structure from original ----
. 
.     * only include non-zero observations
.     keep if mins_worked > 0
{txt} 13{com}. 
.     * get rid of some awkward naming
.     rename *27_37_39_* **
{txt} 14{com}. 
.     * generate regression variables
.     gen_controls_and_FEs
{txt} 15{com}.     gen_treatment_splines rcspl 3 tmax this_week 1
{txt} 16{com}. 
.     * run both specs listed in original gl reg_list
.     foreach reg in $reg_list {c -(}
{txt} 17{com}. 
.         * differentiate treatment if reg is by risk
.         if "`reg'" == "by_risk" loc reg_treatment (${c -(}vars_T_splines{c )-})##i.high_risk
{txt} 18{com}.         else if "`reg'" == "common" loc reg_treatment (${c -(}vars_T_splines{c )-})
{txt} 19{com}.         else di in red "bad reg specification -> pick 'common' or 'by_risk'"
{txt} 20{com}.         di "`reg_treatment'"
{txt} 21{com}. 
.         * both regressions have interacted controls
.         local reg_control (${c -(}usual_controls{c )-})##i.high_risk
{txt} 22{com}.         di "`reg_control'"
{txt} 23{com}. 
.         * interact each fixed effect with the risk binary
.         local reg_fe ""
{txt} 24{com}.         foreach f in $`fe' {c -(}
{txt} 25{com}.             local reg_fe `reg_fe' `f'#high_risk
{txt} 26{com}.         {c )-}
{txt} 27{com}. 
.         * set the ster file name and the notes to be included
.         * (ADD ISO suffix so files don't overwrite across countries)
.         local ster_name "`reg_folder'/uninteracted_reg_`reg'_`C'.ster"
{txt} 28{com}.         local spec_desc "rcspline, 3 knots (27 37 39), tmax, differentiated treatment, fe = $fe, reg_type = `reg', iso = `C'"
{txt} 29{com}. 
.         * set the regression weight (pop_adj for common, risk_adj for by-risk)
.         if "`reg'" == "common" loc weight "pop_adj_sample_wgt"
{txt} 30{com}.         else loc weight "risk_adj_sample_wgt"
{txt} 31{com}. 
.         di "reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)"
{txt} 32{com}.         reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)
{txt} 33{com}. 
.         * count regression N by risk
.         gen included = e(sample)
{txt} 34{com}.         count if included == 1 & high_risk == 1
{txt} 35{com}.         estadd scalar high_N = `r(N)'
{txt} 36{com}.         count if included == 1 & high_risk == 0
{txt} 37{com}.         estadd scalar low_N = `r(N)'
{txt} 38{com}. 
.         estimates notes: "`spec_desc'"
{txt} 39{com}.         estimates save "`ster_name'", replace
{txt} 40{com}. 
.         di "COMPLETED: `reg' regression for iso `C'."
{txt} 41{com}.         drop included
{txt} 42{com}.     {c )-}
{txt} 43{com}. 
.     * ---- END exact inner structure from original ----
. {c )-}
{txt}- foreach C of local countries {c -(}
