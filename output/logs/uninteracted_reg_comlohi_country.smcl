    LevelsOfStrL `varlist' if `touse', separate(`"`separate'"') `clean' matcell(`matcell')
    {c )-}
  - else if (substr("`typ'", 1, 3) == "str") {c -(}
  = else if (substr("str3", 1, 3) == "str") {c -(}
  - local isclean = ("`clean'" != "")
  = local isclean = ("" != "")
