    - mata: st_local("save_any_fe", strofreal(HDFE.save_any_fe))
{res}    {txt}- if ("`residuals'" == "" & `save_any_fe') loc residuals "__temp_reghdfe_resid__"
    = if ("" == "" & 0) loc residuals "__temp_reghdfe_resid__"
    - if ("`residuals'" != "") {c -(}
    = if ("" != "") {c -(}
      if (`verbose' > 0) di as text "# Storing residuals in {c -(}res{c )-}`residuals'{c -(}txt{c )-}" _n
      mata: HDFE.save_variable("`residuals'", HDFE.solution.resid, "Residuals")
      mata: HDFE.solution.residuals_varname = "`residuals'"
      {c )-}
    - mata: HDFE.solution.post()
{res}    {txt}- mata: HDFE.post_footnote()
{res}    {txt}- if (`timeit') timer on 28
    = if (0) timer on 28
    - reghdfe, store_alphas
      {hline 70} begin reghdfe {hline}
      - cap syntax, store_alphas
      - if (!c(rc)) {c -(}
      - Store_Alphas
        {hline 55} begin reghdfe.Store_Alphas {hline}
        - mata: st_local("save_any_fe", strofreal(HDFE.save_any_fe))
{res}        {txt}- assert inlist(`save_any_fe', 0, 1)
        = assert inlist(0, 0, 1)
        - if (`save_any_fe') {c -(}
        = if (0) {c -(}
          _assert e(depvar) != "", msg("e(depvar) is empty")
          _assert e(resid) != "", msg("e(resid) is empty")
          fvrevar `e(depvar)', list
          confirm numeric var `e(resid)', exact
          tempvar d
          if (e(rank)) {c -(}
          qui _predict double `d' if e(sample), xb
          {c )-}
          else if (e(report_constant)) {c -(}
          gen double `d' = _b[_cons] if e(sample)
          {c )-}
          else {c -(}
          gen double `d' = 0 if e(sample)
          {c )-}
          qui replace `d' = `e(depvar)' - `d' - `e(resid)' if e(sample)
          mata: HDFE.store_alphas("`d'")
          drop `d'
          cap drop __temp_reghdfe_resid__
          if (!c(rc)) ereturn local resid
          {c )-}
        {hline 57} end reghdfe.Store_Alphas {hline}
      - exit
      {hline 72} end reghdfe {hline}
