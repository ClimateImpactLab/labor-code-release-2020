{com}{sf}{ul off}{txt}{.-}
      name:  {res}<unnamed>
       {txt}log:  {res}/project/cil/home_dirs/egrenier/repos/labor-code-release-2020/logs/uninteracted_reg_comlohi_country.smcl
  {txt}log type:  {res}smcl
 {txt}opened on:  {res} 9 Oct 2025, 21:38:22
{txt}r; t=0.00 21:38:22

{com}. 
. *------------------------------------------------------------
. * dataset and output folder (mirror original globals/locals)
. *------------------------------------------------------------
. gl dataset      "${c -(}ROOT_INT_DATA{c )-}/regression_ready_data/labor_dataset_splines_nochn_tmax_chn_prev_week_no_ll_0.dta"
{txt}r; t=0.00 21:38:22

{com}. 
. * write per-country ster files to sibling folder
. loc reg_folder  "${c -(}DIR_STER{c )-}/uninteracted_reg_comlohi_country"
{txt}r; t=0.00 21:38:22

{com}. cap mkdir "`reg_folder'"
{txt}r; t=0.00 21:38:22

{com}. 
. * same selections as original
. gl test_code "no"
{txt}r; t=0.00 21:38:22

{com}. gl reg_list by_risk common
{txt}r; t=0.00 21:38:22

{com}. 
. * IMPORTANT: within-country FE bundle you added in functions.do
. * original code expects: foreach f in $`fe' {c -(} ... {c )-}
. * so we set a local 'fe' to the NAME of the global bundle
. loc fe fe_adm0_wk_country_spec
{txt}r; t=0.00 21:38:22

{com}. 
. * optional: skip tiny samples
. loc minN 500
{txt}r; t=0.00 21:38:22

{com}. 
. *------------------------------------------------------------
. * build country list
. *------------------------------------------------------------
. preserve
{txt}r; t=0.00 21:38:22

{com}. use "${c -(}dataset{c )-}", clear
{txt}(Written by R.              )
r; t=1.38 21:38:24

{com}. confirm variable iso
{txt}r; t=0.00 21:38:24

{com}. levelsof iso, local(countries)
  {txt}=        if (N <= 2000) {c -(}
  =        y = srswor(x, 200)
  =        if (rows(t) >= 50) {c -(}
  =        return(multiplicity(sum(t[., 2] :== 1), rows(t)) < 50)
  {hline 73} begin levelsof {hline}
  - version 15.0
  - syntax varname [if] [in] [, Separate(str) MISSing Local(name local) Clean MATROW(name) MATCELL(name) HEXadecimal ]
  - if ("`missing'" == "") {c -(}
  = if ("" == "") {c -(}
  - marksample touse, strok
  - {c )-}
  - else {c -(}
    marksample touse, strok novarlist
    {c )-}
  - if (`"`separate'"' == "") {c -(}
  = if (`""' == "") {c -(}
  - local separate " "
  - {c )-}
  - local typ : type `varlist'
  = local typ : type iso
  - if ("`typ'" == "strL" | substr("`typ'", 1, 3) == "str") {c -(}
  = if ("str3" == "strL" | substr("str3", 1, 3) == "str") {c -(}
  - NoHexadecimal `hexadecimal'
  = NoHexadecimal 
    {hline 57} begin levelsof.NoHexadecimal {hline}
    - if (`"`0'"' == "") {c -(}
    = if (`""' == "") {c -(}
    - exit
    {hline 59} end levelsof.NoHexadecimal {hline}
  - NoMatrow `matrow'
  = NoMatrow 
    {hline 62} begin levelsof.NoMatrow {hline}
    - if (`"`0'"' == "") {c -(}
    = if (`""' == "") {c -(}
    - exit
    {hline 64} end levelsof.NoMatrow {hline}
  - {c )-}
  - mata: st_rclear()
{res}  {txt}- if ("`typ'" == "strL") {c -(}
