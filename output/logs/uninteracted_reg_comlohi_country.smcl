  - else if `"`key'"' == bsubstr("matrix", 1, max(3,`lkey')) {c -(}
  = else if `"save"' == bsubstr("matrix", 1, max(3,4)) {c -(}
    SubcmdMoved "matrix" "ereturn"
    {c )-}
  - else if `"`key'"' == "post" {c -(}
