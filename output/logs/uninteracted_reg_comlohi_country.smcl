    = loc report_constant = "" != "noconstant"
    - loc has_teams = (`"`group_id'"' != "")
    = loc has_teams = (`""' != "")
    - loc has_individual_fe = (`"`individual_id'"' != "")
    = loc has_individual_fe = (`""' != "")
