              {hline 51} begin _get_diopts.Wrapon {hline}
              - capture syntax [, WOrd WIdth]
              - if c(rc) {c -(}
                di as err "invalid fvwrapon() option;"
                syntax [, WOrd WIdth]
                exit 198
                {c )-}
              - opts_exclusive "`word' `width'" fvwrapon
              = opts_exclusive " " fvwrapon
                {hline 53} begin opts_exclusive {hline}
                - version 8.2
                - args opts optname errcode
                - local opts `opts'
                = local opts  
                - local n 0
                - while `"`opts'"' != "" {c -(}
