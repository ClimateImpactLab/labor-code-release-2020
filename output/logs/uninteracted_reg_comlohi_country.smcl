    exit 111
    {c )-}
    else {c -(}
    local anything `"matrix `anything'"'
    {c )-}
    {c )-}
    else {c -(}
    local anything `"scalar `anything'"'
    {c )-}
    {c )-}
  - gettoken subcommand : anything
