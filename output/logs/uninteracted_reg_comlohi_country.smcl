        =transmorphic scalar aggregate_get_funs()
        =        transmorphic scalar                                  funs
        =real matrix select_nm_num(real colvector data) {c -(}
        =string matrix select_nm_str(string colvector data) {c -(}
        =transmorphic colvector aggregate_count(class Factor scalar F, transmorphic colvector data, real colvector weights, string scalar wtype)
        =                return( panelsum(data :<., 1, F.info) )
        =                return( panelsum(data :<., weights, F.info) )
        =real colvector aggregate_sum(class Factor scalar F, real colvector data, real colvector weights, string scalar wtype)
        =                return( panelsum(editmissing(data, 0), 1, F.info) )
        =                real colvector sum_weights
        =                sum_weights = panelsum(weights :* (data :< .), F.info) :/ panelsum(data :< ., F.info)
        =                return( panelsum(editmissing(data, 0), weights, F.info) :/ sum_weights )
        =                return( panelsum(editmissing(data, 0), weights, F.info) )
        =real colvector aggregate_nansum(class Factor scalar F, real colvector data, real colvector weights, string scalar wtype)
        =        return( panelsum(editmissing(data, 0), 1, F.info) :/ (panelsum(data :<., 1, F.info) :> 0) )
        =real colvector aggregate_mean(class Factor scalar F, real colvector data, real colvector weights, string scalar wtype)
        =real colvector aggregate_min(class Factor scalar F, real colvector data, real colvector weights, string scalar wtype)
