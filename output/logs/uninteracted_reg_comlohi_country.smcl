      local names `default'
      {c )-}
    - if "`names'" == "" {c -(}
    = if "." == "" {c -(}
      exit
      {c )-}
    - qui _estimates dir, estimates
    - local est_names `r(names)'
    = local est_names 
    - foreach name of local names {c -(}
    - if "`name'" == "_all" {c -(}
    = if "." == "_all" {c -(}
      local expnames `expnames' `est_names'
      {c )-}
    - else if "`starok'"!="" & "`name'" == "*" {c -(}
    = else if ""!="" & "." == "*" {c -(}
      local expnames `expnames' `est_names'
      {c )-}
    - else if "`name'" == "." {c -(}
    = else if "." == "." {c -(}
    - if "`e(cmd)'" == "" {c -(}
    = if "reghdfe" == "" {c -(}
      di as err "last estimates (.) not found"
      exit 301
      {c )-}
    - else if "`e(_estimates_name)'" != "" {c -(}
    = else if "" != "" {c -(}
      local expnames `expnames' `e(_estimates_name)'
      {c )-}
    - else local expnames `expnames' .
    = else local expnames  .
    - {c )-}
    - else {c -(}
      local enames
      foreach ename of local est_names {c -(}
      if match("`ename'", "`name'") {c -(}
      local enames `enames' `ename'
      {c )-}
      {c )-}
      if "`enames'" == "" {c -(}
      di as err "estimation result `name' not found"
      exit 111
      {c )-}
      local expnames `expnames' `enames'
      {c )-}
    - {c )-}
    - local nnames : word count `expnames'
    = local nnames : word count .
    - if (`min' != 0) & (`nnames' < `min') {c -(}
    = if (0 != 0) & (1 < 0) {c -(}
      di as err "too few names specified"
      exit 198
      {c )-}
    - if (`max' != 32000) & (`nnames' > `max') {c -(}
    = if (32000 != 32000) & (1 > 32000) {c -(}
      di as err "too many names specified"
      exit 198
      {c )-}
    - return local names `expnames'
    = return local names .
    {hline 71} end est_expand {hline}
  - if _rc local enames "`enames'`name' "
