          - if (`"`e(absvars)'"' == "_cons") {c -(}
          = if (`"_cons"' == "_cons") {c -(}
          - exit
          {hline 59} end reghdfe_footnote {hline}
        {hline 54} end reghdfe.ReghdfeFootnote {hline}
      {hline 65} end reghdfe.Replay {hline}
    - if ("`keepmata'" != "") mata: swap(HDFE.solution.data, hdfe_data)
