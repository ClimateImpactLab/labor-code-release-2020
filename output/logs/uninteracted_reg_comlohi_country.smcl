    {c )-}
  - else if `"`key'"' == bsubstr("list", 1, max(2,`lkey')) {c -(}
  = else if `"save"' == bsubstr("list", 1, max(2,4)) {c -(}
    SubcmdMoved "list" "ereturn"
    {c )-}
  - else {c -(}
    di as err `"subcommand {c -(}bf:estimates{c )-} {c -(}bf:`key'{c )-} is unrecognized"'
