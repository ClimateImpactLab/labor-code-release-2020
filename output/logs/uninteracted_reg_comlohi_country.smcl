    - else {c -(}
    - gettoken trash equ : equ0, parse(" =")
    - if `"`trash'"'!="=" {c -(}
    = if `"="'!="=" {c -(}
      local equ `"`equ0'"'
      {c )-}
    - {c )-}
    - {c )-}
    - if "`replace'"=="" {c -(}
    = if ""=="" {c -(}
    - confirm_new_ename `prefix'`name'
