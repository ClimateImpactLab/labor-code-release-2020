        =class Factor scalar __factor_hash1_1(
        =        transmorphic matrix data,
        =    real scalar verbose,
        =    real scalar dict_size,
        =    real scalar sort_levels,
        =    real scalar max_numkeys,
        =    real scalar save_keys)
        =        class Factor scalar                                F
        =        real scalar                               h, num_collisions, j, val
        =        real scalar                               obs, start_obs, num_obs, num_vars
        =        real colvector                                dict
        =        real colvector                                levels
        =        real colvector                                counts
        =        real colvector                                p
        =        transmorphic matrix                             keys
        =        transmorphic rowvector                               key, last_key
        =        string scalar                                msg
        =        assert ((num_vars > 1) + (1) == 1)
        =                key = data[obs]
        =                        {c )-} while (obs <= num_obs ? data[obs] == last_key : 0 )
        =                        key = data[obs]
        =                        keys[val] = key
        =                else if (key == keys[val]) {c -(}
        =                                        keys[val] = key
        =                                if (key == keys[val]) {c -(}
