{res}    {txt}- if ("`residuals'" == "" & `save_any_fe') loc residuals "__temp_reghdfe_resid__"
    = if ("" == "" & 0) loc residuals "__temp_reghdfe_resid__"
    - if ("`residuals'" != "") {c -(}
    = if ("" != "") {c -(}
      if (`verbose' > 0) di as text "# Storing residuals in {c -(}res{c )-}`residuals'{c -(}txt{c )-}" _n
      mata: HDFE.save_variable("`residuals'", HDFE.solution.resid, "Residuals")
      mata: HDFE.solution.residuals_varname = "`residuals'"
      {c )-}
    - mata: HDFE.solution.post()
{res}    {txt}- mata: HDFE.post_footnote()
