            - local allbaselevels `allbaselevels' `noallbaselevels'
            = local allbaselevels  
            - local baselevels `baselevels' `nobaselevels'
            = local baselevels  
            - local emptycells `emptycells' `noemptycells'
            = local emptycells  
            - local omitted `omitted' `noomitted'
            = local omitted  
            - local lstretch `lstretch' `nolstretch'
            = local lstretch  
            - local fvlabel `fvlabel' `nofvlabel'
            = local fvlabel  
            - local abbrev `abbrev' `noabbrev'
            = local abbrev  
            - if "`allbaselevels'`baselevels'" == "" {c -(}
            = if "" == "" {c -(}
            - if c(showbaselevels) == "all" {c -(}
              local allbaselevels allbaselevels
              {c )-}
            - else if c(showbaselevels) == "on" {c -(}
              local baselevels baselevels
              {c )-}
            - {c )-}
            - if "`emptycells'" == "" {c -(}
            = if "" == "" {c -(}
            - if c(showemptycells) == "off" {c -(}
              local emptycells noemptycells
              {c )-}
            - {c )-}
            - if "`omitted'" == "" {c -(}
            = if "" == "" {c -(}
            - if c(showomitted) == "off" {c -(}
              local omitted noomitted
              {c )-}
            - {c )-}
            - if "`lstretch'" == "" {c -(}
            = if "" == "" {c -(}
            - if c(lstretch) == "off" {c -(}
              local lstretch nolstretch
              {c )-}
            - {c )-}
            - if `:length local cformat' {c -(}
            = if 0 {c -(}
              confirm numeric format `cformat'
              if fmtwidth(`"`cformat'"') > 9 {c -(}
              local cformat "%9.0g"
              di "{c -(}txt{c )-}note: invalid cformat(), using default"
              {c )-}
              sreturn local cformat `"`cformat'"'
              local cformat `"cformat(`cformat')"'
              {c )-}
            - if `:length local sformat' {c -(}
            = if 0 {c -(}
              confirm numeric format `sformat'
              if fmtwidth(`"`sformat'"') > 8 {c -(}
              local sformat "%8.2f"
              di "{c -(}txt{c )-}note: invalid sformat(), using default"
              {c )-}
              sreturn local sformat `"`sformat'"'
              local sformat `"sformat(`sformat')"'
              {c )-}
            - if `:length local pformat' {c -(}
            = if 0 {c -(}
              confirm numeric format `pformat'
              if fmtwidth(`"`pformat'"') > 5 {c -(}
              local pformat "%5.3f"
              di "{c -(}txt{c )-}note: invalid pformat(), using default"
              {c )-}
              sreturn local pformat `"`pformat'"'
              local pformat `"pformat(`pformat')"'
              {c )-}
            - if `K' == 1 & `:length local options' {c -(}
            = if 1 == 1 & 0 {c -(}
              syntax namelist(max=2) [, `DIOPTS']
              {c )-}
            - if reldif(`level', c(level)) > 1e-3 {c -(}
            = if reldif(95, c(level)) > 1e-3 {c -(}
              local levelopt level(`level')
              {c )-}
            - Wrapon , `fvwrapon'
            = Wrapon , 
              {hline 51} begin _get_diopts.Wrapon {hline}
              - capture syntax [, WOrd WIdth]
              - if c(rc) {c -(}
                di as err "invalid fvwrapon() option;"
                syntax [, WOrd WIdth]
                exit 198
                {c )-}
              - opts_exclusive "`word' `width'" fvwrapon
              = opts_exclusive " " fvwrapon
                {hline 53} begin opts_exclusive {hline}
                - version 8.2
                - args opts optname errcode
                - local opts `opts'
                = local opts  
                - local n 0
                - while `"`opts'"' != "" {c -(}
                = while `""' != "" {c -(}
                  local ++n
                  gettoken item`n' opts : opts, bind
                  {c )-}
                - if `n' < 2 {c -(}
                = if 0 < 2 {c -(}
                - exit
                {hline 55} end opts_exclusive {hline}
              - local fvwrapon `word' `width'
              = local fvwrapon  
              - if `:length local fvwrapon' {c -(}
              = if 0 {c -(}
                c_local fvwrapon fvwrapon(`fvwrapon')
                {c )-}
              {hline 53} end _get_diopts.Wrapon {hline}
            - if "`fvwrap'" != "" {c -(}
            = if "" != "" {c -(}
              FVWrap, `fvwrap'
              {c )-}
            - c_local `c_diopts' `levelopt' `vsquish' `allbaselevels' `baselevels' `cnsreport' `fullcnsreport' `emptycells' `omitted' `lstretch' `coeflegend' `selegend' `cformat' `sformat' `pformat' `coding' `versus' `compare' `fvwrap' `fvwrapon' `fvlabel' `noci' `nopvalues' `markdown' `citype' `abbrev'
            = c_local DUPS                         
            - if `K' == 2 {c -(}
            = if 1 == 2 {c -(}
              c_local `c_opts' `"`options'"'
              {c )-}
            - sreturn local coding `coding'
            = sreturn local coding 
            - sreturn local versus `versus'
            = sreturn local versus 
            - sreturn local compare `compare'
            = sreturn local compare 
            - sreturn local level `level'
            = sreturn local level 95
            {hline 52} end _get_diopts.GetDiopts {hline}
          - {c )-}
          - else {c -(}
            GetDiopts DUPS options, `options'
            c_local `name2' `"`options'"'
            {c )-}
          - local DUPS : list DUPS - DEFAULT
          - gettoken DUPS : DUPS
          - if `"`DUPS'"' != "" {c -(}
          = if `""' != "" {c -(}
            if (strpos(`"`DUPS'"', "(")) {c -(}
            gettoken DUPS : DUPS, parse("(")
            local DUPS `"`DUPS'()"'
            {c )-}
            di as err "duplicate {c -(}bf:`DUPS'{c )-} option not allowed"
            exit 198
            {c )-}
          - sreturn clear
          - foreach sname of local snames {c -(}
          - sreturn local `sname' = `"`S_`sname''"'
          = sreturn local level = `"95"'
          - {c )-}
          - sreturn local `sname' = `"`S_`sname''"'
          = sreturn local k = `"0"'
          - {c )-}
          {hline 64} end _get_diopts {hline}
