        {c )-}
      {hline 55} end estadd.confirm_new_ename {hline}
    - {c )-}
    - ereturn scalar `prefix'`name' = `equ'
    = ereturn scalar high_N =  11916
    - di _n as txt "added scalar:"

added scalar:
    - added_scalar `prefix'`name'
    = added_scalar high_N
      {hline 58} begin estadd.added_scalar {hline}
      - args name label
      - di as txt %25s `"e(`name') = "' " " as res e(`name') _c
      = di as txt %25s `"e(high_N) = "' " " as res e(high_N) _c
             e(high_N) =  {res}11916      {txt}- if `"`label'"'!="" {c -(}
      = if `""'!="" {c -(}
        di as txt _col(38) `"(`label')"'
        {c )-}
      - else di ""

      {hline 60} end estadd.added_scalar {hline}
    {hline 61} end estadd.estadd_scalar {hline}
  - local rc = _rc
  - restore_estimates_name
