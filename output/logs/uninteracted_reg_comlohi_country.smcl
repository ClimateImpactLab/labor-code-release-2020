    {hline 64} begin _on_colon_parse {hline}
    - version 8.2
    - sreturn local before ""
    - sreturn local after ""
    - gettoken before after : 0, parse(":") bind match(par) quotes
    - if "`par'" != "" {c -(}
    = if "" != "" {c -(}
      local before `"(`before')"'
      {c )-}
    - if `"`before'"' == ":" {c -(}
    = if `"scalar high_N = 1281318"' == ":" {c -(}
      sreturn local after `"`after'"'
      exit
      {c )-}
    - while `"`COLON'"' != ":" & `"`after'"' != "" {c -(}
    = while `""' != ":" & `""' != "" {c -(}
      gettoken COLON after : after, parse(":") bind match(par) quotes
      if "`par'" != "" {c -(}
      local before `before' (`COLON')
      local COLON
      {c )-}
      else if `"`COLON'"' != ":" {c -(}
      local before `"`before' `COLON'"'
      local COLON
      {c )-}
      {c )-}
    - if `"`COLON'"' != ":" {c -(}
    = if `""' != ":" {c -(}
    - di as err "'' found where ':' expected"
    - exit 198
      {c )-}
    {hline 66} end _on_colon_parse {hline}
