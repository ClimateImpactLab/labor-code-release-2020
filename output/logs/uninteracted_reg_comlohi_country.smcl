    = if regexm("high_N = 11916","^r\((.*)\)$") {c -(}
      local name = regexs(1)
      capt confirm name `name'
      confirm scalar `anything'
      if _rc error 198
      local equ "`anything'"
      {c )-}
    - else {c -(}
    - local isname 0
    - gettoken name equ0: anything, parse(" =")
    - capt confirm name `name'
    = capt confirm name high_N
    - if _rc error 198
    - else if `"`equ0'"'=="" {c -(}
    = else if `" = 11916"'=="" {c -(}
      local isname 1
      local equ "scalar(`name')"
