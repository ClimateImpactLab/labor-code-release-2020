        - .`right'.Arrpush `C3' "Number of obs" `C4' "= " as res %`c4wfmt'.0fc e(N)
        = .__000004.Arrpush _col(51) "Number of obs" _col(67) "= " as res %10.0fc e(N)
        - if `"`e(chi2)'"' != "" | "`e(df_r)'" == "" {c -(}
        = if `""' != "" | "3748" == "" {c -(}
          Chi2test `right' `C3' `C4' `c4wfmt'
          {c )-}
        - else {c -(}
        - Ftest `right' `C3' `C4' `c4wfmt'
        = Ftest __000004 _col(51) _col(67) 10
          {hline 53} begin reghdfe_header.Ftest {hline}
          - args right C3 C4 c4wfmt is_svy
          - local df = e(df_r)
          - if !missing(e(F)) {c -(}
          - .`right'.Arrpush `C3' "F(" as res %4.0f e(df_m) as txt "," as res %7.0f `df' as txt ")" `C4' "= " as res %`c4wfmt'.2f e(F)
          = .__000004.Arrpush _col(51) "F(" as res %4.0f e(df_m) as txt "," as res %7.0f 3748 as txt ")" _col(67) "= " as res %10.2f e(F)
          - .`right'.Arrpush `C3' "Prob > F" `C4' "= " as res %`c4wfmt'.4f Ftail(e(df_m),`df',e(F))
          = .__000004.Arrpush _col(51) "Prob > F" _col(67) "= " as res %10.4f Ftail(e(df_m),3748,e(F))
          - {c )-}
          - else {c -(}
            local dfm_l : di %4.0f e(df_m)
            local dfm_l2: di %7.0f `df'
            local j_robust "{c -(}help j_robustsingular##|_new:F(`dfm_l',`dfm_l2'){c )-}"
            .`right'.Arrpush `C3' "`j_robust'" as txt `C4' "= " as result %`c4wfmt's "."
            .`right'.Arrpush `C3' "Prob > F" `C4' "= " as res %`c4wfmt's "."
            {c )-}
          {hline 55} end reghdfe_header.Ftest {hline}
        - {c )-}
        - if !missing(e(r2)) {c -(}
