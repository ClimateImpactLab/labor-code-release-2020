{txt}- estadd scalar low_N = `r(N)'
= estadd scalar low_N = 41716
  {hline 75} begin estadd {hline}
  - version 8.2
  - local caller : di _caller()
  - capt _on_colon_parse `macval(0)'
  = capt _on_colon_parse scalar low_N = 41716
    {hline 64} begin _on_colon_parse {hline}
    - version 8.2
    - sreturn local before ""
    - sreturn local after ""
    - gettoken before after : 0, parse(":") bind match(par) quotes
    - if "`par'" != "" {c -(}
    = if "" != "" {c -(}
      local before `"(`before')"'
      {c )-}
    - if `"`before'"' == ":" {c -(}
    = if `"scalar low_N = 41716"' == ":" {c -(}
      sreturn local after `"`after'"'
      exit
      {c )-}
    - while `"`COLON'"' != ":" & `"`after'"' != "" {c -(}
    = while `""' != ":" & `""' != "" {c -(}
