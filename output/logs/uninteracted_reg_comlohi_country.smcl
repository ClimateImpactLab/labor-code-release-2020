{txt}- estadd scalar high_N = `r(N)'
= estadd scalar high_N = 11916
  {hline 75} begin estadd {hline}
  - version 8.2
  - local caller : di _caller()
  - capt _on_colon_parse `macval(0)'
  = capt _on_colon_parse scalar high_N = 11916
    {hline 64} begin _on_colon_parse {hline}
    - version 8.2
    - sreturn local before ""
    - sreturn local after ""
    - gettoken before after : 0, parse(":") bind match(par) quotes
    - if "`par'" != "" {c -(}
    = if "" != "" {c -(}
      local before `"(`before')"'
      {c )-}
    - if `"`before'"' == ":" {c -(}
    = if `"scalar high_N = 11916"' == ":" {c -(}
      sreturn local after `"`after'"'
      exit
      {c )-}
    - while `"`COLON'"' != ":" & `"`after'"' != "" {c -(}
    = while `""' != ":" & `""' != "" {c -(}
      gettoken COLON after : after, parse(":") bind match(par) quotes
      if "`par'" != "" {c -(}
      local before `before' (`COLON')
      local COLON
      {c )-}
      else if `"`COLON'"' != ":" {c -(}
      local before `"`before' `COLON'"'
      local COLON
      {c )-}
      {c )-}
    - if `"`COLON'"' != ":" {c -(}
    = if `""' != ":" {c -(}
    - di as err "'' found where ':' expected"
    - exit 198
      {c )-}
    {hline 66} end _on_colon_parse {hline}
  - if !_rc {c -(}
    local 0 `"`s(before)'"'
    local names `"`s(after)'"'
    {c )-}
  - syntax anything(equalok id="subcommand") [if] [in] [fw aw iw pw] [, * ]
  - if regexm(`"`anything'"',"^r\((.*)\)$") {c -(}
  = if regexm(`"scalar high_N = 11916"',"^r\((.*)\)$") {c -(}
    capt confirm scalar `anything'
    if _rc {c -(}
    capt confirm matrix `anything'
    if _rc {c -(}
    di as err `"`anything' not found"'
    exit 111
    {c )-}
    else {c -(}
    local anything `"matrix `anything'"'
    {c )-}
    {c )-}
    else {c -(}
    local anything `"scalar `anything'"'
    {c )-}
    {c )-}
  - gettoken subcommand : anything
  - capt confirm name `subcommand'
  = capt confirm name scalar
  - if _rc {c -(}
    di as err "invalid subcommand"
    exit 198
    {c )-}
  - if `"`options'"'!="" local options `", `options'"'
  = if `""'!="" local options `", "'
  - if `"`weight'`exp'"'!="" local wgtexp `"[`weight'`exp']"'
  = if `""'!="" local wgtexp `"[]"'
  - tempname rcurrent ecurrent
  - capt _return drop `rcurrent'
  = capt _return drop __000000
  - _return hold `rcurrent'
  = _return hold __000000
  - capt noisily {c -(}
  - local names: list retok names
  - if "`names'"=="" {c -(}
  = if ""=="" {c -(}
  - local names "."
  - local qui
  - {c )-}
  - else local qui quietly
  - foreach name of local names {c -(}
  - if "`name'"=="." {c -(}
  = if "."=="." {c -(}
  - capt est_expand "`name'"
  = capt est_expand "."
    {hline 69} begin est_expand {hline}
    - version 8
    - syntax anything [, min(int 0) max(int 32000) Default(str) starok ]
    - local names `anything'
    = local names "."
    - if "`names'" == "" {c -(}
    = if "." == "" {c -(}
      local names `default'
      {c )-}
    - if "`names'" == "" {c -(}
    = if "." == "" {c -(}
      exit
      {c )-}
    - qui _estimates dir, estimates
    - local est_names `r(names)'
    = local est_names 
    - foreach name of local names {c -(}
    - if "`name'" == "_all" {c -(}
    = if "." == "_all" {c -(}
      local expnames `expnames' `est_names'
      {c )-}
    - else if "`starok'"!="" & "`name'" == "*" {c -(}
    = else if ""!="" & "." == "*" {c -(}
      local expnames `expnames' `est_names'
      {c )-}
    - else if "`name'" == "." {c -(}
    = else if "." == "." {c -(}
    - if "`e(cmd)'" == "" {c -(}
    = if "reghdfe" == "" {c -(}
      di as err "last estimates (.) not found"
      exit 301
      {c )-}
    - else if "`e(_estimates_name)'" != "" {c -(}
    = else if "" != "" {c -(}
      local expnames `expnames' `e(_estimates_name)'
      {c )-}
    - else local expnames `expnames' .
    = else local expnames  .
    - {c )-}
    - else {c -(}
      local enames
      foreach ename of local est_names {c -(}
      if match("`ename'", "`name'") {c -(}
      local enames `enames' `ename'
      {c )-}
      {c )-}
      if "`enames'" == "" {c -(}
      di as err "estimation result `name' not found"
      exit 111
      {c )-}
      local expnames `expnames' `enames'
      {c )-}
    - {c )-}
    - local nnames : word count `expnames'
    = local nnames : word count .
    - if (`min' != 0) & (`nnames' < `min') {c -(}
    = if (0 != 0) & (1 < 0) {c -(}
      di as err "too few names specified"
      exit 198
      {c )-}
    - if (`max' != 32000) & (`nnames' > `max') {c -(}
    = if (32000 != 32000) & (1 > 32000) {c -(}
      di as err "too many names specified"
      exit 198
      {c )-}
    - return local names `expnames'
    = return local names .
    {hline 71} end est_expand {hline}
  - if _rc local enames "`enames'`name' "
  = if _rc local enames ". "
  - else local enames "`enames'`r(names)' "
  = else local enames ". "
  - {c )-}
  - else {c -(}
    est_expand "`name'"
    local enames "`enames'`r(names)' "
    {c )-}
  - {c )-}
  - local names: list uniq enames
  - if "`names'"=="." local active
  = if "."=="." local active
  - else {c -(}
    capt est_expand .
    if _rc local active "."
    else local active "`r(names)'"
    if "`active'"=="." | `:list posof "`active'" in names'==0 {c -(}
    local active
    _est hold `ecurrent', restore estsystem nullok
    {c )-}
    {c )-}
  - {c )-}
  - if _rc {c -(}
    _return restore `rcurrent'
    exit _rc
    {c )-}
  - _return restore `rcurrent', hold
  = _return restore __000000, hold
  - nobreak {c -(}
  - foreach m of local names {c -(}
  - if "`names'"!="." {c -(}
  = if "."!="." {c -(}
    if "`m'"=="." _est unhold `ecurrent'
    else {c -(}
    capt confirm new var _est_`m'
    if _rc qui replace _est_`m' = 0 if _est_`m' >=.
    _est unhold `m'
    {c )-}
    {c )-}
  - backup_estimates_name
    {hline 51} begin estadd.backup_estimates_name {hline}
    - ereturn local _estadd_estimates_name `"`e(_estimates_name)'"'
    = ereturn local _estadd_estimates_name `""'
    - ereturn local _estimates_name ""
    {hline 53} end estadd.backup_estimates_name {hline}
  - capt n break `qui' version `caller': estadd_`macval(anything)' `if' `in' `wgtexp' `options'
  = capt n break  version 16.1: estadd_scalar high_N = 11916    
    {hline 59} begin estadd.estadd_scalar {hline}
    - version 8.2
    - syntax anything(equalok) [, Prefix(name) Replace Quietly ]
    - if regexm("`anything'","^r\((.*)\)$") {c -(}
    = if regexm("high_N = 11916","^r\((.*)\)$") {c -(}
      local name = regexs(1)
      capt confirm name `name'
      confirm scalar `anything'
      if _rc error 198
      local equ "`anything'"
      {c )-}
    - else {c -(}
    - local isname 0
    - gettoken name equ0: anything, parse(" =")
    - capt confirm name `name'
    = capt confirm name high_N
    - if _rc error 198
    - else if `"`equ0'"'=="" {c -(}
    = else if `" = 11916"'=="" {c -(}
      local isname 1
      local equ "scalar(`name')"
      {c )-}
    - else {c -(}
    - gettoken trash equ : equ0, parse(" =")
    - if `"`trash'"'!="=" {c -(}
    = if `"="'!="=" {c -(}
      local equ `"`equ0'"'
      {c )-}
    - {c )-}
    - {c )-}
    - if "`replace'"=="" {c -(}
    = if ""=="" {c -(}
    - confirm_new_ename `prefix'`name'
    = confirm_new_ename high_N
      {hline 53} begin estadd.confirm_new_ename {hline}
      - capture confirm existence `e(`0')'
      = capture confirm existence 
      - if !_rc {c -(}
        di as err "e(`0') already defined"
        exit 110
        {c )-}
      {hline 55} end estadd.confirm_new_ename {hline}
    - {c )-}
    - ereturn scalar `prefix'`name' = `equ'
    = ereturn scalar high_N =  11916
    - di _n as txt "added scalar:"

added scalar:
    - added_scalar `prefix'`name'
    = added_scalar high_N
      {hline 58} begin estadd.added_scalar {hline}
      - args name label
      - di as txt %25s `"e(`name') = "' " " as res e(`name') _c
      = di as txt %25s `"e(high_N) = "' " " as res e(high_N) _c
             e(high_N) =  {res}11916      {txt}- if `"`label'"'!="" {c -(}
      = if `""'!="" {c -(}
        di as txt _col(38) `"(`label')"'
        {c )-}
      - else di ""

      {hline 60} end estadd.added_scalar {hline}
    {hline 61} end estadd.estadd_scalar {hline}
  - local rc = _rc
  - restore_estimates_name
    {hline 50} begin estadd.restore_estimates_name {hline}
    - local hold `"`e(_estadd_estimates_name)'"'
    = local hold `""'
    - ereturn local _estadd_estimates_name ""
    - ereturn local _estimates_name `"`hold'"'
    = ereturn local _estimates_name `""'
    {hline 52} end estadd.restore_estimates_name {hline}
  - if "`names'"!="." {c -(}
  = if "."!="." {c -(}
    if "`m'"=="." _est hold `ecurrent', restore estsystem nullok
    else _est hold `m', estimates varname(_est_`m')
    {c )-}
  - if `rc' continue, break
  = if 0 continue, break
  - {c )-}
  - if "`active'"!="" estimates restore `active', noh
  = if ""!="" estimates restore , noh
  - {c )-}
  - _return restore `rcurrent'
  = _return restore __000000
  - if `rc' {c -(}
  = if 0 {c -(}
    if `rc' == 199 di as error "invalid subcommand"
    exit `rc'
    {c )-}
  {hline 77} end estadd {hline}
- count if included == 1 & high_risk == 0
