        = local fvlabel  
        - local abbrev `abbrev' `noabbrev'
        = local abbrev  
        - if "`allbaselevels'`baselevels'" == "" {c -(}
        = if "" == "" {c -(}
        - if c(showbaselevels) == "all" {c -(}
          local allbaselevels allbaselevels
          {c )-}
        - else if c(showbaselevels) == "on" {c -(}
          local baselevels baselevels
          {c )-}
        - {c )-}
        - if "`emptycells'" == "" {c -(}
        = if "" == "" {c -(}
        - if c(showemptycells) == "off" {c -(}
          local emptycells noemptycells
          {c )-}
        - {c )-}
        - if "`omitted'" == "" {c -(}
        = if "" == "" {c -(}
        - if c(showomitted) == "off" {c -(}
          local omitted noomitted
          {c )-}
        - {c )-}
        - if "`lstretch'" == "" {c -(}
        = if "" == "" {c -(}
        - if c(lstretch) == "off" {c -(}
          local lstretch nolstretch
          {c )-}
        - {c )-}
        - if `:length local cformat' {c -(}
        = if 0 {c -(}
          confirm numeric format `cformat'
          if fmtwidth(`"`cformat'"') > 9 {c -(}
          local cformat "%9.0g"
          di "{c -(}txt{c )-}note: invalid cformat(), using default"
          {c )-}
          sreturn local cformat `"`cformat'"'
          local cformat `"cformat(`cformat')"'
          {c )-}
        - if `:length local sformat' {c -(}
        = if 0 {c -(}
          confirm numeric format `sformat'
          if fmtwidth(`"`sformat'"') > 8 {c -(}
          local sformat "%8.2f"
          di "{c -(}txt{c )-}note: invalid sformat(), using default"
          {c )-}
          sreturn local sformat `"`sformat'"'
          local sformat `"sformat(`sformat')"'
          {c )-}
        - if `:length local pformat' {c -(}
        = if 0 {c -(}
          confirm numeric format `pformat'
          if fmtwidth(`"`pformat'"') > 5 {c -(}
          local pformat "%5.3f"
          di "{c -(}txt{c )-}note: invalid pformat(), using default"
          {c )-}
          sreturn local pformat `"`pformat'"'
          local pformat `"pformat(`pformat')"'
          {c )-}
        - if `K' == 1 & `:length local options' {c -(}
        = if 2 == 1 & 0 {c -(}
          syntax namelist(max=2) [, `DIOPTS']
          {c )-}
        - if reldif(`level', c(level)) > 1e-3 {c -(}
        = if reldif(95, c(level)) > 1e-3 {c -(}
          local levelopt level(`level')
          {c )-}
        - Wrapon , `fvwrapon'
        = Wrapon , 
          {hline 55} begin _get_diopts.Wrapon {hline}
          - capture syntax [, WOrd WIdth]
          - if c(rc) {c -(}
            di as err "invalid fvwrapon() option;"
            syntax [, WOrd WIdth]
            exit 198
            {c )-}
          - opts_exclusive "`word' `width'" fvwrapon
          = opts_exclusive " " fvwrapon
            {hline 57} begin opts_exclusive {hline}
            - version 8.2
            - args opts optname errcode
            - local opts `opts'
            = local opts  
            - local n 0
            - while `"`opts'"' != "" {c -(}
            = while `""' != "" {c -(}
              local ++n
              gettoken item`n' opts : opts, bind
              {c )-}
            - if `n' < 2 {c -(}
            = if 0 < 2 {c -(}
            - exit
            {hline 59} end opts_exclusive {hline}
          - local fvwrapon `word' `width'
          = local fvwrapon  
          - if `:length local fvwrapon' {c -(}
