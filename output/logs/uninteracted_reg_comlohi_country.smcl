        = if ""!="" & ("reghdfe"!="gnbreg" | ""=="svy") {c -(}
          local k_eform `e(k_eform)'
          if ("`k_eform'"=="") {c -(}
          local k_eform = 1
          {c )-}
          local k_eq `e(k_eq)'
          if ("`k_eq'"=="") {c -(}
          local k_eq = 1
          {c )-}
          if (`k_eform'<`k_eq' & `k_eform') {c -(}
          if ("`e(cmd2)'" == "stintreg" | "`e(cmd2)'" == "streg") & ("`e(cmd)'" == "weibull" | "`e(cmd)'" == "gompertz") {c -(}
          {c )-}
          else {c -(}
          _eform_multeq_note efnote : `k_eform'
          di as txt "`efnote'"
          {c )-}
          {c )-}
          {c )-}
        - if (`"`eformdi'"'!="" & "`e(noconstant)'"=="0" & `"`eform_cons_ti'"'!="" & "`e(consonly)'"!="1") {c -(}
        = if (`""'!="" & ""=="0" & `""'!="" & ""!="1") {c -(}
          if ("`e(cmd)'"=="asclogit" | "`e(cmd)'"=="cmclogit" | "`e(cmd)'"=="cmmixlogit" | "`e(cmd)'"=="cmxtmixlogit" ) {c -(}
          local asvar = `"`e(ranvars)'`e(fixvars)'`e(indvars)'"' != ""
          if `"`e(casevars)'"' != "" & `asvar' {c -(}
          local note1 "Exponentiated coefficients represent odds ratios for "
          local note2 "alternative-specific variables (first equation) and "
          local note3 "{c -(}help j_cmrisk##|_new:relative-risk ratios{c )-} "
          local note4 "for case-specific variables."
          di as txt "{c -(}p 0 6 2{c )-}Note: `note1'`note2'`note3'`note4'{c -(}p_end{c )-}"
          {c )-}
          {c )-}
          if "`eform_cons_ti'" == "Inc. Rate" {c -(}
          local eform_cons_note "incidence rate"
          {c )-}
          else if "`eform_cons_ti'" == "Rel. Risk" {c -(}
          local eform_cons_note "relative risk"
          {c )-}
          else if "`eform_cons_ti'" == "Health" {c -(}
          local eform_cons_note "health (probability of no disease)"
          {c )-}
          else {c -(}
          local eform_cons_note = strlower(`"`eform_cons_ti'"')
          {c )-}
          local eform_cons_note "baseline `eform_cons_note'"
          if ("`e(cmd2)'"=="") {c -(}
          local cmd `e(cmd)'
          {c )-}
          else {c -(}
          local cmd `e(cmd2)'
          {c )-}
          local f2 = udsubstr("`cmd'",1,2)
          local is_re = ("`f2'"=="xt" | "`f2'"=="me")
          if `is_re' {c -(}
          local extranote " (conditional on zero random effects)"
          {c )-}
          di as txt "{c -(}p 0 6 2{c )-}Note: {c -(}res:_cons{c )-} estimates " "`eform_cons_note'`extranote'" _c
          if ("`e(cmd)'"=="mlogit" | "`e(cmd)'"=="asclogit" | "`e(cmd)'"=="cmclogit" | "`e(cmd)'"=="cmmixlogit" | "`e(cmd)'"=="cmxtmixlogit" ) {c -(}
          di as txt " for each outcome" _c
          {c )-}
          di as txt ".{c -(}p_end{c )-}"
          {c )-}
        - {c )-}
        - return add
        - if !`keepmc' {c -(}
        = if !0 {c -(}
        - return local mcmethod
        - return local mctitle
        - {c )-}
        {hline 66} end _coef_table {hline}
      - return add
      - if ("`footnote'" == "") ReghdfeFootnote
      = if ("" == "") ReghdfeFootnote
        {hline 52} begin reghdfe.ReghdfeFootnote {hline}
        - reghdfe_footnote
          {hline 57} begin reghdfe_footnote {hline}
          - syntax [, width(int 13)]
          - if (`"`e(absvars)'"' == "_cons") {c -(}
          = if (`"_cons"' == "_cons") {c -(}
          - exit
          {hline 59} end reghdfe_footnote {hline}
        {hline 54} end reghdfe.ReghdfeFootnote {hline}
      {hline 65} end reghdfe.Replay {hline}
    - if ("`keepmata'" != "") mata: swap(HDFE.solution.data, hdfe_data)
    = if ("" != "") mata: swap(HDFE.solution.data, hdfe_data)
    - if ("`keepmata'" != "") mata: swap(HDFE.solution.tss, hdfe_tss)
    = if ("" != "") mata: swap(HDFE.solution.tss, hdfe_tss)
    - if ("`keepmata'" != "") c_local keep_mata 1
    = if ("" != "") c_local keep_mata 1
    - if (`timeit') {c -(}
    = if (0) {c -(}
      timer off 20
      ViewTimer, title("Top-level") percent range(20 29) legend(21 "HDFE" 22 "DoF" 23 "Expand factors/Lags" 24 "Partial out" 25 "Solve OLS" 27 "Parallel Boss" 28 "Store alphas")
      ViewTimer, title("Partial-out") percent range(40 49) legend(41 "Load data" 42 "Standardize/etc" 46 "MAP/LSMR" 47 "Data assign" 49 "Parallel Save")
      {c )-}
    {hline 65} end reghdfe.Estimate {hline}
  - Cleanup `c(rc)' `keep_mata'
  = Cleanup 0 0
    {hline 64} begin reghdfe.Cleanup {hline}
    - args rc keep_mata
    - loc cleanup_folder = !`keep_mata' & ("$LAST_PARALLEL_DIR"!="")
    = loc cleanup_folder = !0 & (""!="")
    - if (`cleanup_folder') cap mata: unlink_folder(HDFE.parallel_dir, 0)
    = if (0) cap mata: unlink_folder(HDFE.parallel_dir, 0)
    - global LAST_PARALLEL_DIR
    - global pids
    - if (!`keep_mata') cap mata: mata drop HDFE
    = if (!0) cap mata: mata drop HDFE
    - cap mata: mata drop hdfe_*
    - cap drop __temp_reghdfe_resid__
    - if (`rc') exit `rc'
    = if (0) exit 0
    {hline 66} end reghdfe.Cleanup {hline}
  {hline 76} end reghdfe {hline}
