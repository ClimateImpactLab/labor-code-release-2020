    - else if "`starok'"!="" & "`name'" == "*" {c -(}
    = else if ""!="" & "." == "*" {c -(}
      local expnames `expnames' `est_names'
      {c )-}
    - else if "`name'" == "." {c -(}
    = else if "." == "." {c -(}
    - if "`e(cmd)'" == "" {c -(}
    = if "reghdfe" == "" {c -(}
      di as err "last estimates (.) not found"
      exit 301
      {c )-}
    - else if "`e(_estimates_name)'" != "" {c -(}
    = else if "" != "" {c -(}
      local expnames `expnames' `e(_estimates_name)'
      {c )-}
    - else local expnames `expnames' .
    = else local expnames  .
    - {c )-}
    - else {c -(}
      local enames
      foreach ename of local est_names {c -(}
      if match("`ename'", "`name'") {c -(}
      local enames `enames' `ename'
      {c )-}
      {c )-}
      if "`enames'" == "" {c -(}
