    {hline 64} begin _on_colon_parse {hline}
    - version 8.2
    - sreturn local before ""
    - sreturn local after ""
    - gettoken before after : 0, parse(":") bind match(par) quotes
    - if "`par'" != "" {c -(}
    = if "" != "" {c -(}
      local before `"(`before')"'
      {c )-}
    - if `"`before'"' == ":" {c -(}
    = if `"scalar high_N = 11916"' == ":" {c -(}
      sreturn local after `"`after'"'
      exit
      {c )-}
    - while `"`COLON'"' != ":" & `"`after'"' != "" {c -(}
    = while `""' != ":" & `""' != "" {c -(}
      gettoken COLON after : after, parse(":") bind match(par) quotes
      if "`par'" != "" {c -(}
      local before `before' (`COLON')
      local COLON
      {c )-}
      else if `"`COLON'"' != ":" {c -(}
      local before `"`before' `COLON'"'
      local COLON
      {c )-}
      {c )-}
    - if `"`COLON'"' != ":" {c -(}
    = if `""' != ":" {c -(}
    - di as err "'' found where ':' expected"
    - exit 198
      {c )-}
    {hline 66} end _on_colon_parse {hline}
  - if !_rc {c -(}
    local 0 `"`s(before)'"'
    local names `"`s(after)'"'
    {c )-}
  - syntax anything(equalok id="subcommand") [if] [in] [fw aw iw pw] [, * ]
  - if regexm(`"`anything'"',"^r\((.*)\)$") {c -(}
  = if regexm(`"scalar high_N = 11916"',"^r\((.*)\)$") {c -(}
    capt confirm scalar `anything'
    if _rc {c -(}
    capt confirm matrix `anything'
    if _rc {c -(}
    di as err `"`anything' not found"'
    exit 111
    {c )-}
    else {c -(}
    local anything `"matrix `anything'"'
    {c )-}
    {c )-}
    else {c -(}
    local anything `"scalar `anything'"'
    {c )-}
    {c )-}
  - gettoken subcommand : anything
  - capt confirm name `subcommand'
  = capt confirm name scalar
  - if _rc {c -(}
    di as err "invalid subcommand"
    exit 198
    {c )-}
  - if `"`options'"'!="" local options `", `options'"'
  = if `""'!="" local options `", "'
  - if `"`weight'`exp'"'!="" local wgtexp `"[`weight'`exp']"'
  = if `""'!="" local wgtexp `"[]"'
  - tempname rcurrent ecurrent
