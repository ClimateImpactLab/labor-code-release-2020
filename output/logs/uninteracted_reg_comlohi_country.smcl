  - if "`leads_lags'"=="all_weeks"{c -(}
  = if "this_week"=="all_weeks"{c -(}
    global vars_T_splines ${c -(}vars_T_splines{c )-} c.`t_version'_`spl_varname'_`N_knots'kn_t`splines_term'
    global vars_T_x_gdp_splines ${c -(}vars_T_x_gdp_splines{c )-} c.`t_version'_`spl_varname'_`N_knots'kn_t`splines_term'#c.log_gdp_pc_adm1
