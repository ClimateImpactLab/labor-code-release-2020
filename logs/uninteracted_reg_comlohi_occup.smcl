{smcl}
{com}{sf}{ul off}{txt}{.-}
      name:  {res}<unnamed>
       {txt}log:  {res}/project/cil/home_dirs/maiqi/repos/labor-code-release-2020/logs/uninteracted_reg_comlohi_occup.smcl
  {txt}log type:  {res}smcl
 {txt}opened on:  {res}23 Jan 2026, 10:46:24

{com}. 
. * select dataset and output folder

. gl dataset      "/project/cil/battuta_shares/gcp/estimation/labor/code_release_int_data/regression_ready_data/labor_dataset_splines_nochn_tmax_chn_prev_week_no_ll_0_agnonag_272841_0121.dta"

. loc reg_folder  "${c -(}DIR_STER{c )-}/uninteracted_reg_comlohi"

. 
. * other selections

. gl test_code "no"

. gl reg_list by_risk common

. loc fe fe_adm0_wk

. 
. * ---------- CHOOSE WHICH RISK DEFINITION TO USE ----------

. * options: "high_risk" or "high_risk_old"

. global risk_def "occup_code2" 

. * ---------------------------------------------------------

. 
. *****************

. *  LOAD DATA AND CREATE WEIGHTS

. *****************

. 
. use "$dataset", clear
{txt}(Written by R.              )

{com}. 
. capture program drop create_risk_weights

. program define create_risk_weights
{txt}  1{com}. 
. syntax varname, base_weight(varname) [suffix(string)]
{txt}  2{com}.     
. * Store the grouping variable name
. local group_var `varlist'
{txt}  3{com}.     
. * Set default suffix to empty if not provided
. if "`suffix'" == "" {c -(}
{txt}  4{com}. local suffix ""
{txt}  5{com}. {c )-}
{txt}  6{com}.     
. * Calculate proportions within iso
. bysort iso `group_var': gen `group_var'_prop = _N 
{txt}  7{com}. by iso: replace `group_var'_prop = `group_var'_prop/_N 
{txt}  8{com}.     
. * Adjust weights by proportion
. gen risk_adj_sample_wgt`suffix' = `base_weight' * `group_var'_prop
{txt}  9{com}. bysort `group_var': egen `group_var'_sum = total(risk_adj_sample_wgt`suffix')
{txt} 10{com}. gen total_`group_var'_share = _N 
{txt} 11{com}. bysort `group_var': replace total_`group_var'_share = _N / total_`group_var'_share
{txt} 12{com}. replace risk_adj_sample_wgt`suffix' = risk_adj_sample_wgt`suffix' / `group_var'_sum * total_`group_var'_share
{txt} 13{com}.     
. * clean up
. drop total_`group_var'_share `group_var'_prop `group_var'_sum
{txt} 14{com}.     
. * Representative unit sample weights - by rep_unit
. gegen rep_unit_tot_wgt`suffix' = total(risk_adj_sample_wgt`suffix'), by(rep_unit)
{txt} 15{com}. gen rep_unit_sample_wgt`suffix' = risk_adj_sample_wgt`suffix'/rep_unit_tot_wgt`suffix'
{txt} 16{com}. gegen test_sum`suffix' = total(rep_unit_sample_wgt`suffix'), by(rep_unit)
{txt} 17{com}.     
. * Representative unit sample weights - by rep_unit and year
. gegen rep_unit_year_tot_wgt`suffix' = total(risk_adj_sample_wgt`suffix'), by(rep_unit year)
{txt} 18{com}. gen rep_unit_year_sample_wgt`suffix' = risk_adj_sample_wgt`suffix'/rep_unit_year_tot_wgt`suffix'
{txt} 19{com}. gegen test_sum_2`suffix' = total(rep_unit_year_sample_wgt`suffix'), by(rep_unit year)
{txt} 20{com}.     
. * Test weights
. count if (round(test_sum`suffix') != 1) | (round(test_sum_2`suffix') != 1)
{txt} 21{com}. if `r(N)' != 0 {c -(}
{txt} 22{com}. di as error "Whoops, you biffed it! Sample weights for `group_var' don't add to 1."
{txt} 23{com}. {c )-}
{txt} 24{com}. else {c -(}
{txt} 25{com}. di as result "Great job, sample weights for `group_var' correctly generated."
{txt} 26{com}. drop rep_unit_tot_wgt`suffix' rep_unit_year_tot_wgt`suffix' test_sum`suffix' test_sum_2`suffix'
{txt} 27{com}. {c )-}
{txt} 28{com}.     
. end

. 
. * run function to create weights for each of the three variables. Occupations code weights to

. * be made in regression script for flexibility

. create_risk_weights occup_code, base_weight(pop_adj_sample_wgt) suffix(_occup)
{txt}(6,595,853 real changes made)
(6,595,853 real changes made)
(6,595,853 real changes made)
{res}{txt}{res}{txt}{res}{txt}{res}{txt}{res}  0
Great job, sample weights for occup_code correctly generated.

{com}. gen occup_code2 = occup_code

. replace occup_code2 = 0 if occup_code == 2 
{txt}(1,840,105 real changes made)

{com}. replace occup_code2 = 0 if occup_code == 3 
{txt}(252,889 real changes made)

{com}. create_risk_weights occup_code2, base_weight(pop_adj_sample_wgt) suffix(_occup2)
{txt}(6,595,853 real changes made)
(6,595,853 real changes made)
(6,595,853 real changes made)
{res}{txt}{res}{txt}{res}{txt}{res}{txt}{res}  0
Great job, sample weights for occup_code2 correctly generated.

{com}. gen occupindus = 0

. replace occupindus = 1 if high_risk == 1 and occup_code2 ==1
{err}invalid 'and' 
{txt}{search r(198), local:r(198);}

{com}. create_risk_weights occupindus, base_weight(pop_adj_sample_wgt) suffix(_oi)
{txt}(6,595,853 real changes made)
(6,595,853 real changes made)
(6,595,853 real changes made)
{res}{txt}{res}{txt}{res}{txt}{res}{txt}{res}  0
Great job, sample weights for occupindus correctly generated.

{com}. ********************

. *  RUN REGRESSION

. ********************

. 
. * cycle through each of the two regressions

. foreach reg in $reg_list {c -(}
{txt}  2{com}. 
.     di "`reg_list'"
{txt}  3{com}. 
.     preserve
{txt}  4{com}. 
.     * if test code mode is on, take a random sample
.     if "${c -(}test_code{c )-}"=="yes" {c -(}
{txt}  5{com}.         sample 0.1
{txt}  6{com}.     {c )-}
{txt}  7{com}. 
.     * only include non-zero observations
.     keep if mins_worked > 0
{txt}  8{com}. 
.     * get rid of some awkward naming
.     rename *27_28_41_* ** 
{txt}  9{com}. 
.     * ---------- DEFINE risk_level FROM CHOSEN SOURCE ----------
.     cap drop risk_level 
{txt} 10{com}.     gen risk_level = .   
{txt} 11{com}.     replace risk_level = high_risk     if "${c -(}risk_def{c )-}"=="high_risk"
{txt} 12{com}.     replace risk_level = high_risk_old if "${c -(}risk_def{c )-}"=="high_risk_old"
{txt} 13{com}.     replace risk_level = sector if "${c -(}risk_def{c )-}"=="sector"
{txt} 14{com}.     replace risk_level = occup_code if "${c -(}risk_def{c )-}"=="occup_code"
{txt} 15{com}. replace risk_level = occup_code2 if "${c -(}risk_def{c )-}"=="occup_code2"
{txt} 16{com}.     * generate regression variables
.     gen_controls_and_FEs
{txt} 17{com}.     gen_treatment_splines rcspl 3 tmax this_week 1
{txt} 18{com}. 
.     * differentiate treatment if reg is by risk
.     if "`reg'" == "by_risk" loc reg_treatment (${c -(}vars_T_splines{c )-})##i.risk_level 
{txt} 19{com}.     else if "`reg'" == "common" loc reg_treatment (${c -(}vars_T_splines{c )-})
{txt} 20{com}.     else di in red "bad reg specification -> pick 'common' or 'by_risk'"
{txt} 21{com}.     di "`reg_treatment'"
{txt} 22{com}. 
.     * both regressions have interacted controls
.     local reg_control (${c -(}usual_controls{c )-})##i.risk_level    
{txt} 23{com}.     di "`reg_control'"
{txt} 24{com}.     
.     * interact each fixed effect with the risk binary
.     local reg_fe ""                    
{txt} 25{com}.     foreach f in $`fe' {c -(}
{txt} 26{com}.         local reg_fe `reg_fe' `f'#risk_level         
{txt} 27{com}.     {c )-}
{txt} 28{com}. * -------------------------------------------------------------------------------------------------------
.     * set the ster file name and the notes to be included
.     local ster_name "`reg_folder'/uninteracted_reg_`reg'_2026_272841_oi.ster"
{txt} 29{com}.     local spec_desc "rcspline, 3 knots (27 28 41), tmax, differentiated treatment, fe = $fe, reg_type = `reg'"
{txt} 30{com}.     
. * -------------------------------------------------------------------------------------------------------
.     * set the regression weight (pop_adj for common, risk_adj for by-risk)
.     if "`reg'" == "common" loc weight "pop_adj_sample_wgt"
{txt} 31{com}.     else loc weight "risk_adj_sample_wgt_oi"
{txt} 32{com}. 
.     di "reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)"
{txt} 33{com}.     reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)
{txt} 34{com}. 
.     * count regression N by risk
.     gen included = e(sample)
{txt} 35{com}.     count if included == 1 & risk_level == 1       
{txt} 36{com}.     estadd scalar high_N = `r(N)'
{txt} 37{com}.     count if included == 1 & risk_level == 0      
{txt} 38{com}.     estadd scalar low_N = `r(N)'
{txt} 39{com}. 
.     
.     estimates notes: "`spec_desc'"
{txt} 40{com}.     estimates save "`ster_name'", replace
{txt} 41{com}. 
.     di "COMPLETED: `reg' regression."
{txt} 42{com}.     
.     restore
{txt} 43{com}. 
. {c )-}

