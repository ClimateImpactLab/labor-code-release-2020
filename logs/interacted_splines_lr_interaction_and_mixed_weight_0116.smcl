{txt} 62{com}. 
.     *** This will give you un-useable estimate for LR
.     *if "`reg'" == "1_factor" loc reg_treatment (${c -(}vars_T_splines{c )-} ${c -(}vars_T_x_gdp_splines{c )-})##i.risk_level
.   
.     else if "`reg'" == "2_factor" loc reg_treatment (${c -(}vars_T_splines{c )-} ${c -(}vars_T_x_gdp_splines{c )-} ${c -(}vars_T_x_lr_tmax_splines{c )-})##i.risk_level
{txt} 63{com}.     else di in red "bad reg specification -> pick '1 factor' or '2 factor'"
{txt} 64{com}.     di "`reg_treatment'"
{txt} 65{com}. 
.     * both regressions have interacted controls
.     local reg_control (${c -(}usual_controls{c )-})##i.risk_level
{txt} 66{com}.     di "`reg_control'"
{txt} 67{com}.     
.     * interact each fixed effect with the risk binary
.     local reg_fe ""                    
{txt} 68{com}.     foreach f in $`fe' {c -(}
{txt} 69{com}.         local reg_fe `reg_fe' `f'#risk_level
{txt} 70{com}.     {c )-}
{txt} 71{com}. * -------------------------------------------------------------------------------------------------------
.     * set the ster file name and the notes to be included
.     local ster_name "`reg_folder'/interacted_reg_`reg'_2025_272841.ster"
{txt} 72{com}.     local spec_desc "rcspline, 3 knots (27 28 41), tmax, differentiated treatment withlr interaction, fe = $fe, reg_type = `reg'"
{txt} 73{com}. 
. * -------------------------------------------------------------------------------------------------------
.     * set the regression weight
.     *replace risk_adj_sample_wgt = rep_unit_year_sample_wgt if risk_level == 1
.     loc weight "rep_unit_year_sample_wgt"
{txt} 74{com}. 
.     di "reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)"
{txt} 75{com}.     reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)
{txt} 76{com}. 
.     * count regression N by risk
.     gen included = e(sample)
{txt} 77{com}.     count if included == 1 & risk_level == 0
{txt} 78{com}.     estadd scalar low_N = `r(N)'
{txt} 79{com}.     count if included == 1 & risk_level == 1
{txt} 80{com}.     estadd scalar high_N = `r(N)'
{txt} 81{com}.  *   count if included == 1 & risk_level == 2
.   *  estadd scalar nonag_N = `r(N)'
. 
.     estimates notes: "`spec_desc' representative unit-year weights"
{txt} 82{com}.     estimates save "`ster_name'", replace
{txt} 83{com}. 
.     di "COMPLETED: `reg' regression."
{txt} 84{com}. 
. {c )-}

