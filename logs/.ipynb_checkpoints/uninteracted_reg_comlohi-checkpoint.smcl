{smcl}
{com}{sf}{ul off}{txt}{.-}
      name:  {res}<unnamed>
       {txt}log:  {res}/project/cil/home_dirs/egrenier/repos/labor-code-release-2020/logs/uninteracted_reg_comlohi.smcl
  {txt}log type:  {res}smcl
 {txt}opened on:  {res} 3 Apr 2025, 13:34:05
{txt}
{com}. 
. * select dataset and output folder
. gl dataset              "${c -(}ROOT_INT_DATA{c )-}/regression_ready_data/labor_dataset_splines_nochn_tmax_chn_prev_week_no_ll_0.dta"
{txt}
{com}. loc reg_folder  "${c -(}DIR_STER{c )-}/uninteracted_reg_comlohi"
{txt}
{com}. 
. * other selections
. gl test_code "no"
{txt}
{com}. gl reg_list common
{txt}
{com}. loc fe fe_adm0_wk
{txt}
{com}. 
. ********************
. *       RUN REGRESSION
. ********************
. 
. * cycle through each of the two regressions
. foreach reg in $reg_list {c -(}
{txt}  2{com}. 
.         di "`reg_list'"
{txt}  3{com}. 
.         use $dataset, clear
{txt}  4{com}. 
.         * if test code mode is on, take a random sample
.         if "${c -(}test_code{c )-}"=="yes" {c -(}
{txt}  5{com}.                 sample 0.1
{txt}  6{com}.         {c )-}
{txt}  7{com}. 
.         * only include non-zero observations
.         keep if mins_worked > 0
{txt}  8{com}. 
.         * get rid of some awkward naming
.         rename *27_37_39_* **
{txt}  9{com}. 
.         * generate regression variables
.         gen_controls_and_FEs
{txt} 10{com}.         gen_treatment_splines rcspl 3 tmax this_week 1
{txt} 11{com}. 
.         * differentiate treatment if reg is by risk
.         if "`reg'" == "by_risk" loc reg_treatment (${c -(}vars_T_splines{c )-})##i.high_risk
{txt} 12{com}.         else if "`reg'" == "common" loc reg_treatment (${c -(}vars_T_splines{c )-})
{txt} 13{com}.         else di in red "bad reg specification -> pick 'common' or 'by_risk'"
{txt} 14{com}.         di "`reg_treatment'"
{txt} 15{com}. 
.         * both regressions have interacted controls
.         local reg_control (${c -(}usual_controls{c )-})##i.high_risk
{txt} 16{com}.         di "`reg_control'"
{txt} 17{com}.         
.         * interact each fixed effect with the risk binary
.         local reg_fe ""                                 
{txt} 18{com}.         foreach f in $`fe' {c -(}
{txt} 19{com}.                 local reg_fe `reg_fe' `f'#high_risk
{txt} 20{com}.         {c )-}
{txt} 21{com}. 
.         * set the ster file name and the notes to be included
.         local ster_name "`reg_folder'/uninteracted_reg_`reg'_2025.ster"
{txt} 22{com}.         local spec_desc "rcspline, 3 knots (27 37 39), tmax, differentiated treatment, fe = $fe, reg_type = `reg'"
{txt} 23{com}. 
.         * set the regression weight (pop_adj for common, risk_adj for by-risk)
.         if "`reg'" == "common" loc weight "pop_adj_sample_wgt"
{txt} 24{com}.         else loc weight "risk_adj_sample_wgt"
{txt} 25{com}. 
.         di "reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)"
{txt} 26{com}.         reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)
{txt} 27{com}. 
.         * count regression N by risk
.         gen included = e(sample)
{txt} 28{com}.         count if included == 1 & high_risk == 1
{txt} 29{com}.         estadd scalar high_N = `r(N)'
{txt} 30{com}.         count if included == 1 & high_risk == 0
{txt} 31{com}.         estadd scalar low_N = `r(N)'
{txt} 32{com}. 
.         estimates notes: "`spec_desc'"
{txt} 33{com}.         estimates save "`ster_name'", replace
{txt} 34{com}. 
.         di "COMPLETED: `reg' regression."
{txt} 35{com}. 
. {c )-}

