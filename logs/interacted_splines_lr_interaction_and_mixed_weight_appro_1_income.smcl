{txt}134{com}.     count if included == 1 & risk_level == 1
{txt}135{com}.     estadd scalar high_N = `r(N)'
{txt}136{com}.     
.     estimates notes: "`spec_desc' representative unit-year weights"
{txt}137{com}.     estimates save "`ster_name'", replace
{txt}138{com}.     
.     di "COMPLETED: `reg' regression."
