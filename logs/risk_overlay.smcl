. ***************************************
. *       COLLECT_POLYNOMIAL_TERMS
. 
. *       put coefficients in macros
. ***************************************
. 
. cap prog drop collect_polynomial_terms
{txt}
{com}. prog def collect_polynomial_terms
{txt}  1{com}.         syntax , order(numlist) unint(string) int(string)
{txt}  2{com}. 
.         forval degree=1(1)`order' {c -(}
{txt}  3{com}. 
.                 #d ;
{txt}delimiter now ;
{com}.                 gl `unint'`degree' =
>                         "_b[tmax_p`degree'] +" +
>                         "_b[tmax_p`degree'_v1] +" + 
>                         "_b[tmax_p`degree'_v2] +" +
>                         "_b[tmax_p`degree'_v3] +" +
>                         "_b[tmax_p`degree'_v4] +" +
>                         "_b[tmax_p`degree'_v5] +" +
>                         "_b[tmax_p`degree'_v6] "
>                 ;
{txt}  4{com}.                 gl `int'`degree' = 
>                         "_b[1.high_risk#c.tmax_p`degree'] +" + 
>                         "_b[1.high_risk#c.tmax_p`degree'_v1] +" + 
>                         "_b[1.high_risk#c.tmax_p`degree'_v2] +" +
>                         "_b[1.high_risk#c.tmax_p`degree'_v3] +" + 
>                         "_b[1.high_risk#c.tmax_p`degree'_v4] +" +
>                         "_b[1.high_risk#c.tmax_p`degree'_v5] +" +
>                         "_b[1.high_risk#c.tmax_p`degree'_v6] "
>                 ;
{txt}  5{com}.                 #d cr
{txt}delimiter now cr
{com}.         {c )-}
{txt}  6{com}. 
. end
{txt}
{com}. 
. ***************************************
. *       COLLECT_BIN_TERMS
. 
. *       put coefficients in macros
. ***************************************
. 
. cap prog drop collect_bin_terms
{txt}
{com}. prog def collect_bin_terms
{txt}  1{com}.         syntax , bins(string) unint(string) int(string)
{txt}  2{com}.         
.         di in red "Bin values are hard-coded in "               ///
>         "this function (14 = (0,2) ... etc). Ensure "   ///
>         "they are correct."
{txt}  3{com}. 
.         * get values corresponding to each bin (because
.         * bins are very randomly named)
.         gl min_below0 = -30
{txt}  4{com}.         gl max_below0 = 0
{txt}  5{com}.         gl min_above42 = 42
{txt}  6{com}.         gl max_above42 = 60
{txt}  7{com}.         gl min_14 = 0
{txt}  8{com}.         gl max_14 = 3
{txt}  9{com}.         forval bin=15(1)27 {c -(}
{txt} 10{com}.                 loc prev_bin = `bin' - 1
{txt} 11{com}.                 gl min_`bin' = ${c -(}min_`prev_bin'{c )-} + 3
{txt} 12{com}.                 gl max_`bin' = ${c -(}max_`prev_bin'{c )-} + 3
{txt} 13{com}.         {c )-}
{txt} 14{com}. 
.         * collect numeric and string names of bins
.         numlist "14(1)27"
{txt} 15{com}.         gl `bins' "`r(numlist)' above42 below0"
{txt} 16{com}. 
.         * collect the coefficients for each bin
.         foreach bin in $`bins' {c -(}
{txt} 17{com}. 
.                 * add prefix for numerical bins
.                 if ("`bin'" != "above42") & ("`bin'" != "below0") loc coef "b3C_`bin'"
{txt} 18{com}.                 else loc coef `bin'
{txt} 19{com}. 
.                 #d ;
{txt}delimiter now ;
{com}.                 gl `unint'`bin' =
>                         "_b[`coef'] +" +
>                         "_b[`coef'_v1] +" + 
>                         "_b[`coef'_v2] +" + 
>                         "_b[`coef'_v3] +" + 
>                         "_b[`coef'_v4] +" + 
>                         "_b[`coef'_v5] +" + 
>                         "_b[`coef'_v6] "
> 
>                 ;
{txt} 20{com}.                 gl `int'`bin' = 
>                         "_b[1.high_risk#c.`coef'] +" + 
>                         "_b[1.high_risk#c.`coef'_v1] +" + 
>                         "_b[1.high_risk#c.`coef'_v2] +" + 
>                         "_b[1.high_risk#c.`coef'_v3] +" + 
>                         "_b[1.high_risk#c.`coef'_v4] +" + 
>                         "_b[1.high_risk#c.`coef'_v5] +" + 
>                         "_b[1.high_risk#c.`coef'_v6] "
>                 ;
{txt} 21{com}.                 #d cr
{txt}delimiter now cr
{com}.         {c )-}
{txt} 22{com}. 
. end
{txt}
{com}. 
. ***************************************
. *       CONVERT_TABLE
. 
. *       change a response function CSV
. *       into a Latex table
. ***************************************
. 
. cap prog drop convert_table
{txt}
{com}. prog def convert_table
{txt}  1{com}. 
.         syntax , categories(string) r2(numlist) n(numlist)
{txt}  2{com}. 
.         di in red "R2, N and regression categories must all have the same order."
{txt}  3{com}. 
.         keep yhat* se* temp
{txt}  4{com}. 
.         foreach j in `categories' {c -(}
{txt}  5{com}. 
.                 * get stars
.                 gen t_stats`j'  = abs(yhat_`j'/se_`j')
{txt}  6{com}.                 gen p`j'                = ""
{txt}  7{com}.                 replace p`j'    = "*" if t_stats`j' > 1.645
{txt}  8{com}.                 replace p`j'    = "**" if t_stats`j' > 1.960
{txt}  9{com}.                 replace p`j'    = "***" if t_stats`j' > 2.576
{txt} 10{com}. 
.                 * reformat yhat
.                 gen double `j'1 = round(yhat_`j', 0.01)
{txt} 11{com}.                 format `j'1 %03.2f
{txt} 12{com}.                 tostring `j'1, replace force
{txt} 13{com}.                 replace `j'1 = `j'1 + p`j'
{txt} 14{com}.                 
.                 * reformat standard errors
.                 gen double `j'2 = round(se_`j', 0.01)
{txt} 15{com}.                 format `j'2 %03.2f
{txt} 16{com}.                 tostring `j'2, replace force
{txt} 17{com}.                 replace `j'2 = "(" + `j'2 + ")"
{txt} 18{com}. 
.         {c )-}
{txt} 19{com}. 
.         * reshape to table format (yhat with se below)
.         reshape long `categories', i(temp) j(line)
{txt} 20{com}.         sort temp line
{txt} 21{com}.         tostring temp, replace force
{txt} 22{com}.         replace temp = "" if line == 2
{txt} 23{com}.         keep `categories' temp
{txt} 24{com}. 
.         * add R2 and N
.         set obs `=_N+2'
{txt} 25{com}.         replace temp = "\hline Adj. R2"         in `=_N-1'
{txt} 26{com}.         replace temp = "N"                                      in `=_N'
{txt} 27{com}.         loc i = 1
{txt} 28{com}.         foreach cat in `categories' {c -(}
{txt} 29{com}. 
.                 cap replace `cat' = "`: word `i' of `r2''"      in `=_N-1'
{txt} 30{com}.                 cap replace `cat' = "`: word `i' of `n''"       in `=_N'
{txt} 31{com}. 
.                 loc ++i
{txt} 32{com}.         {c )-}
{txt} 33{com}. 
. 
. end
{txt}
{com}. 
. ***************************************
. *       SUBSAMPLE DATA
. 
. *       drop data that's not in the subsample
. ***************************************
. 
. cap prog drop subsample_data
{txt}
{com}. prog def subsample_data
{txt}  1{com}. 
.         args reg
{txt}  2{com}. 
.         * this is *truly* ugly, please fix it
.         if "`reg'" == "inc_t1" keep if inc_t == 1
{txt}  3{com}.         if "`reg'" == "inc_t2" keep if inc_t == 2
{txt}  4{com}.         if "`reg'" == "inc_t3" keep if inc_t == 3
{txt}  5{com}.         if "`reg'" == "clim_t1" keep if clim_t == 1
{txt}  6{com}.         if "`reg'" == "clim_t2" keep if clim_t == 2
{txt}  7{com}.         if "`reg'" == "clim_t3" keep if clim_t == 3
{txt}  8{com}.         if "`reg'" == "inc_q1_clim_q1" keep if inc_q == 1 & clim_q == 1
{txt}  9{com}.         if "`reg'" == "inc_q1_clim_q2" keep if inc_q == 1 & clim_q == 2
{txt} 10{com}.         if "`reg'" == "inc_q2_clim_q1" keep if inc_q == 2 & clim_q == 1
{txt} 11{com}.         if "`reg'" == "inc_q2_clim_q2" keep if inc_q == 2 & clim_q == 2
{txt} 12{com}. 
. end
{txt}
{com}. 
{txt}end of do-file

{com}. do "/project/cil/home_dirs/maiqi/repos/labor-code-release-2020/2_analysis/all_interacted_reg_code/rf_interacted_1_factor.do"
{txt}
{com}. *****************
. *       INITIALIZE
. *****************
. 
. * get functions and paths
. run "/project/cil/home_dirs/`c(username)'/repos/labor-code-release-2020/0_subroutines/paths.do"
{txt}
{com}. run "${c -(}DIR_REPO_LABOR{c )-}/2_analysis/0_subroutines/functions.do"
{txt}
{com}. 
. * select dataset and output folder
. loc reg_folder  "${c -(}DIR_OUTPUT{c )-}/interacted_reg_output/ster"
{txt}
{com}. loc rf_folder   "${c -(}DIR_OUTPUT{c )-}/interacted_reg_output/rf"
{txt}
{com}. cap mkdir `rf_folder'
{txt}
{com}. 
. * other selections
. global reg_list 1_factor
{txt}
{com}. global ref_temp 27 
{txt}
{com}. 
. * full response function
. numlist "-20(0.1)47"
{txt}
{com}. gl full_response `r(numlist)'
{txt}
{com}. * 6 table values
. numlist "45 40 35 30 10 5 0 -5 -10"
{txt}
{com}. gl table_values `r(numlist)'
{txt}
{com}. 
. 
. ***********************************
. *       GENERATE RESPONSE FUNCTION CSVS
. ***********************************
. 
. foreach row_values in full_response {c -(}
{txt}  2{com}. 
.         foreach reg in $reg_list {c -(}
{txt}  3{com}. 
.                 * set the ster file name and the output CSV
.                 local ster_name "`reg_folder'/interacted_reg_`reg'_2025.ster" // _2025.ster"
{txt}  4{com}.                 local rf_name   "`rf_folder'/interacted_reg_`reg'_`row_values'_2025.csv"
{txt}  5{com}.                 
.                 * create the temp list that we want to predict for
.                 qui make_temp_dist, list($`row_values') ref($ref_temp)
{txt}  6{com}.                 est use `ster_name'
{txt}  7{com}.                 
. 
.                 * generate spline terms and collect in macros
