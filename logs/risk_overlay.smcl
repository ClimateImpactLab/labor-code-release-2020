. cap program drop make_spline_terms
{txt}
{com}. program define make_spline_terms
{txt}  1{com}.         args knot1 knot2 knot3
{txt}  2{com}.         * local knot1 = 16.6
.         * local knot2 = 30.3
.         * local knot3 = 36.6
.         glob knots = "`knot1' `knot2' `knot3'"
{txt}  3{com}.         di "$knots"
{txt}  4{com}. 
.         local scaling_factor=(`knot3'-`knot1')^2
{txt}  5{com}.         mkspline T_spline=temp, cubic knots($knots)
{txt}  6{com}.         mkspline ref_spline=ref, cubic knots($knots)
{txt}  7{com}. 
.         di "matching these splines with the transformed-after-aggregated data"
{txt}  8{com}. 
.         forval k=2/2{c -(}
{txt}  9{com}.                 replace T_spline`k'=T_spline`k'*`scaling_factor'
{txt} 10{com}.                 replace ref_spline`k'=ref_spline`k'*`scaling_factor'
{txt} 11{com}.         {c )-}
{txt} 12{com}. 
.         forval k = 1/2{c -(}
{txt} 13{com}.                 loc j = `k' - 1
{txt} 14{com}.                 ren T_spline`k' T_spline`j'
{txt} 15{com}.                 ren ref_spline`k' ref_spline`j'
{txt} 16{com}.         {c )-}
{txt} 17{com}. end 
{txt}
{com}. 
. 
. * f-test writer function
. cap program drop test_interaction_spline
{txt}
{com}. program define test_interaction_spline
{txt}  1{com}.         args f N_knots data_subset ster_name wgt
{txt}  2{com}.         
.         estimates use "${c -(}ster_dir{c )-}/`ster_name'.ster"
{txt}  3{com}. 
.         local N_new_vars=`N_knots'-2 
{txt}  4{com}. 
.         * matrix for F test results
.         putexcel set "${c -(}rf_folder{c )-}/test_spline_results.xlsx", sheet("`wgt'") modify
{txt}  5{com}.         mat results = J(2,6,.)
{txt}  6{com}.         local j = 1
{txt}  7{com}. 
.         foreach risk in lr hl {c -(}
{txt}  8{com}.                 global test_exp_gdp 0
{txt}  9{com}.                 global test_exp_lrtmax 0
{txt} 10{com}.                 global test_exp_gdp_and_lrtmax 0
{txt} 11{com}. 
.                 forval i=0/`N_new_vars'{c -(}
{txt} 12{com}.                         global test_exp_gdp $test_exp_gdp = (${c -(}b_T_x_gdp_spline_`i'_`risk'{c )-}) 
{txt} 13{com}.                         global test_exp_lrtmax $test_exp_lrtmax = (${c -(}b_T_x_lrtmax_spline_`i'_`risk'{c )-}) 
{txt} 14{com}.                         global test_exp_gdp_and_lrtmax $test_exp_gdp_and_lrtmax = (${c -(}b_T_x_gdp_spline_`i'_`risk'{c )-}) = (${c -(}b_T_x_lrtmax_spline_`i'_`risk'{c )-}) 
{txt} 15{com}. 
.                 {c )-}
{txt} 16{com}. 
.                 local colnames = "`colnames' `risk'_GDP_interaction"
{txt} 17{com}.                 test ${c -(}test_exp_gdp{c )-} 
{txt} 18{com}.                 mat results[1, `j'] = `r(F)'
{txt} 19{com}.                 mat results[2, `j'] = `r(p)'
{txt} 20{com}.                 local ++j
{txt} 21{com}.                 local colnames = "`colnames' `risk'_lrtmax_interaction"
{txt} 22{com}.                 test ${c -(}test_exp_lrtmax{c )-}
{txt} 23{com}.                 mat results[1, `j'] = `r(F)'
{txt} 24{com}.                 mat results[2, `j'] = `r(p)'
{txt} 25{com}.                 local ++j
{txt} 26{com}.                 local colnames = "`colnames' `risk'_joint_interaction"
{txt} 27{com}.                 test ${c -(}test_exp_gdp_and_lrtmax{c )-}
{txt} 28{com}.                 mat results[1, `j'] = `r(F)'
{txt} 29{com}.                 mat results[2, `j'] = `r(p)'
{txt} 30{com}.                 local ++j
{txt} 31{com}.         {c )-}
{txt} 32{com}.         
.         mat colnames results  = `colnames'
{txt} 33{com}.         mat rownames results  = F pval
{txt} 34{com}.         putexcel A1 = matrix(results), names
{txt} 35{com}. 
. end
{txt}
{com}. 
. 
. * generate spline temperature
. cap program drop spline_temperature_range
{txt}
{com}. program define spline_temperature_range
{txt}  1{com}.         * after generating the normal temperature variables
.         * we transform them into spline terms with this program
. 
.         args N_knots  
{txt}  2{com}. 
. 
.         if `N_knots' == 3 {c -(}
{txt}  3{com}.                 local knots 27 37 39
{txt}  4{com}.         {c )-}
{txt}  5{com}.         
.         *Stata formula is different from the formula we used to get the spline of real temperatures, by a scalar factor. 
.         *We use Stata formula to transform the range of temperature that we multiply by the estimates 
.         *Hence after Stata processed the ranged we need to rescale the output to use it with our estimates based on aggregated splines (not if those were computed by Stata)
. 
.         local N_vars_sp=`N_knots'-1
{txt}  6{com}. 
.         loc count=1
{txt}  7{com}.         * find the first and last knots, the scaling factor, and use 
.         * stata's mkspline to generate the temperature vectors 
.         * which we'll then multiply with the corresponding coefficients to generate the plots
.         foreach k in `knots'{c -(}
{txt}  8{com}. 
.                 if `count'==1{c -(}
{txt}  9{com}.                         loc first_knot=`k'
{txt} 10{com}.                 {c )-}
{txt} 11{com}.                 if `count'==`N_knots'{c -(}
{txt} 12{com}.                         loc last_knot=`k'
{txt} 13{com}.                 {c )-}
{txt} 14{com}.                 loc count=`count' + 1
{txt} 15{com}.         {c )-}
{txt} 16{com}. 
.         local scaling_factor=(`last_knot'-`first_knot')^2
{txt} 17{com}. 
.         mkspline T_spline=temp, cubic knots(`knots')
{txt} 18{com}.         mkspline T_ref_spline=ref, cubic knots(`knots')
{txt} 19{com}. 
.         di "matching these splines with the transformed-after-aggregated data"
{txt} 20{com}. 
.         * linear term doesn't need to be scaled
.         forval k=2/`N_vars_sp'{c -(}
{txt} 21{com}.                 replace T_spline`k'=T_spline`k'*`scaling_factor'
{txt} 22{com}.                 replace T_ref_spline`k'=T_ref_spline`k'*`scaling_factor'
{txt} 23{com}.         {c )-}
{txt} 24{com}. 
.         rename T_spline1 T_spline0
{txt} 25{com}.         rename T_spline2 T_spline1
{txt} 26{com}.         rename T_ref_spline1 T_ref_spline0
{txt} 27{com}.         rename T_ref_spline2 T_ref_spline1
{txt} 28{com}. end
{txt}
{com}. 
. 
. * generate response function
. cap program drop gen_response_surface_spline
{txt}
{com}. program define gen_response_surface_spline
{txt}  1{com}. 
.         args N_knots risk grid
{txt}  2{com}. 
.         * N_new_vars = 1 in 3 knots case
.         local N_new_vars=`N_knots'-2 
{txt}  3{com}.         global response_surface 0
{txt}  4{com}.         * i = 0/1
.         * sum up the terms in the response function
.         forval i=0/`N_new_vars'{c -(}
{txt}  5{com}.                 gl response_surface ${c -(}response_surface{c )-}+(${c -(}b_T_spline_`i'`risk'{c )-})*(T_spline`i'-T_ref_spline`i')
{txt}  6{com}.                 gl response_surface ${c -(}response_surface{c )-}+(${c -(}b_T_x_gdp_spline_`i'`risk'{c )-})*(T_spline`i'-T_ref_spline`i')*${c -(}minc`grid'{c )-}
{txt}  7{com}.                 if "$interaction" == "interacted" |  "$interaction" == "triple_int" {c -(}
{txt}  8{com}.                         gl response_surface ${c -(}response_surface{c )-}+(${c -(}b_T_x_lrtmax_spline_`i'`risk'{c )-})*(T_spline`i'-T_ref_spline`i')*${c -(}lrtmax`grid'{c )-}
{txt}  9{com}.                 {c )-}
{txt} 10{com}.                 if "$interaction" == "triple_int" {c -(}
{txt} 11{com}.                         gl response_surface ${c -(}response_surface{c )-}+(${c -(}b_T_x_gdp_x_lrtmax_spline_`i'`risk'{c )-})*(T_spline`i'-T_ref_spline`i')*${c -(}minc`grid'{c )-}*${c -(}lrtmax`grid'{c )-}
{txt} 12{com}.                 {c )-}
{txt} 13{com}. 
.         {c )-}
{txt} 14{com}.         cap drop yhat *_ci
{txt} 15{com}.         di "`risk' `grid': $response_surface"
{txt} 16{com}.         predictnl yhat = $response_surface, ci(lower_ci upper_ci)
{txt} 17{com}. end
{txt}
{com}. 
. 
. * generate the marginal response of long run gdp or tmax
. cap program drop gen_marginal_resp_spline
{txt}
{com}. program define gen_marginal_resp_spline
{txt}  1{com}. 
.         args N_knots marginal_var risk
{txt}  2{com}. 
.         local N_new_vars=`N_knots'-2 
{txt}  3{com}. 
.         global response 0
{txt}  4{com}. 
.         forval i=0/`N_new_vars'{c -(}
{txt}  5{com}.                 global response $response + (${c -(}b_T_x_`marginal_var'_spline_`i'`risk'{c )-})*(T_spline`i' - T_ref_spline`i')
{txt}  6{com}.         {c )-}
{txt}  7{com}.         cap drop yhat *_ci
{txt}  8{com}.         di "$response"
{txt}  9{com}.         predictnl yhat = $response, ci(lower_ci upper_ci)
{txt} 10{com}. end
{txt}
{com}. 
. 
. * call the other functions to put together the plots
. cap program drop plot_interacted_spline
{txt}
{com}. program define plot_interacted_spline
{txt}  1{com}.         args interaction f N_knots data_subset plot_style ster_name hist_weight hist_style
{txt}  2{com}. 
.         cap mkdir `plot_style'
{txt}  3{com}.         cd `plot_style'
{txt}  4{com}. 
.         di "Using: ${c -(}ster_dir{c )-}/`ster_name'.ster"
{txt}  5{com}.         estimates use "${c -(}ster_dir{c )-}/`ster_name'.ster"
{txt}  6{com}. 
.         generate_temperature -20 50 27
{txt}  7{com}.         spline_temperature_range 3
{txt}  8{com}. 
.         if "`interaction'" == "income" loc size = 50
{txt}  9{com}.         else loc size = 20
{txt} 10{com}. 
.         di "INTERACTION : `interaction' `size'"
{txt} 11{com}. 
.         * lr: low risk, hr: high risk (risk interaction terms only), hl: lr + hr = response of high risk 
.         foreach risk in _hr _lr _hr {c -(}
{txt} 12{com}.                 * generate the 3 or 9 plots
.                 forval g = 1/$max_g {c -(}
{txt} 13{com}.                         gen_response_surface_spline `N_knots' `risk' `g'
{txt} 14{com}.                         gen_plot "${c -(}tag`g'{c )-}" `g' `plot_style' `risk' `hist_weight' `size' 
{txt} 15{com}.                 {c )-}
{txt} 16{com}.                 if "`risk'" == "_lr" local plot_tag low_risk
{txt} 17{com}.                 if "`risk'" == "_hr" local plot_tag high_risk
{txt} 18{com}.                 if "`risk'" == "_hr" local plot_tag marginal_risk
{txt} 19{com}. 
.                 * add in the histogram subplots
.                 forval i=1(1)$max_g {c -(}
{txt} 20{com}.                         local h`i' = "/project/cil/home_dirs/`c(username)'/repos/labor-code-release-2020/output/interacted_reg_output/plots/histograms/$interaction/hist`i'`risk'_`hist_style'.gph"
{txt} 21{com}.                 {c )-}
{txt} 22{com}.                 
.                 if "`interaction'" != "income" {c -(}
{txt} 23{com}.                         graph combine plot7 plot8 plot9 "`h7'" "`h8'" "`h9'" plot4 plot5 plot6 "`h4'" "`h5'" "`h6'" plot1 plot2 plot3 "`h1'" "`h2'" "`h3'", plotregion(color(white)) graphregion(color(white) margin(t=5 b=5)) xcomm imargin(0 0 0 0) cols(3) title("`plot_tag'") subtitle("`ster_name', hist: `hist_weight' `hist_style'", size(vsmall))
{txt} 24{com}.                 {c )-}
{txt} 25{com}.                 else {c -(}
{txt} 26{com}.                         graph combine plot1 plot2 plot3 "`h1'" "`h2'" "`h3'", plotregion(color(white)) graphregion(color(white) margin(t=5 b=5)) xcomm imargin(0 0 0 0) cols(3) title("`plot_tag'") subtitle("`ster_name', hist: `hist_weight' `hist_style'", size(vsmall))
{txt} 27{com}.                 {c )-}
{txt} 28{com}.                 graph export "`ster_name'_`plot_tag'_hist`hist_weight'_`hist_style'.pdf", replace
{txt} 29{com}.  
.         {c )-}
{txt} 30{com}. 
.         if "`interaction'" == "triple_int" {c -(}
{txt} 31{com}. 
.                 foreach marginal_var in lrtmax gdp {c -(}
{txt} 32{com}.                         * plot marginal effect of lrtmax and log gdp per capita
.                         foreach risk in _lr _hr {c -(}
{txt} 33{com}. 
.                                 forval g = 1/3 {c -(}
{txt} 34{com}. 
.                                         gen_varying_marginal_resp_spline `N_knots' `marginal_var' `risk' `g'
{txt} 35{com}.                                         di "PLOTTING `g' for `marginal_var' and ${c -(}other_var{c )-}`g' == ${c -(}$other_var{c )-}`g'{c )-}"
{txt} 36{com}.                                         gen_marg_plot "${c -(}other_var{c )-}`g'" `marginal_var'`g' `plot_style' 
{txt} 37{com}. 
.                                 {c )-}
{txt} 38{com}. 
.                                 graph combine `marginal_var'1 `marginal_var'2 `marginal_var'3, plotregion(color(white)) graphregion(color(white)) cols(3) ycommon title("`marginal_var'_`risk'") subtitle("`ster_name'")
{txt} 39{com}.                                 graph export "`ster_name'_marginal_`marginal_var'`risk'.pdf", replace
{txt} 40{com}.                                 
.                         {c )-}
{txt} 41{com}.                 {c )-}
{txt} 42{com}.         {c )-}
{txt} 43{com}. 
.         else {c -(}
{txt} 44{com}.                 if "`interaction'" == "income" loc marg_vars "gdp"
{txt} 45{com}.                 else loc marg_vars = "gdp lrtmax"
{txt} 46{com}.                 foreach marginal_var in `marg_vars' {c -(}
{txt} 47{com}.                         * plot marginal effect of lrtmax and log gdp per capita
.                         foreach risk in _hl _lr _hr {c -(}
{txt} 48{com}. 
.                                 gen_marginal_resp_spline `N_knots' `marginal_var' `risk'
{txt} 49{com}.                                 export delim using "marginal_resp_spline_`risk'_`marginal_var'.csv", replace
{txt} 50{com}.                                 if "`risk'" == "_lr" local plot_tag low_risk
{txt} 51{com}.                                 if "`risk'" == "_hr" local plot_tag high_risk
{txt} 52{com}.                                 
.                                 gen_marg_plot "`plot_tag'" `plot_tag' `plot_style' 
{txt} 53{com}.                         {c )-}
{txt} 54{com}.                         graph combine low_risk high_risk, plotregion(color(white)) graphregion(color(white)) cols(2) ycommon title("`marginal_var'") subtitle("`ster_name'")
{txt} 55{com}.                         graph export "`ster_name'_marginal_`marginal_var'.pdf", replace
{txt} 56{com}.                 {c )-}
{txt} 57{com}.         {c )-}
{txt} 58{com}.         cd ..
{txt} 59{com}. end
