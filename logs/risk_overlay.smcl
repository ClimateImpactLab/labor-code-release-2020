. 
.                 global b_T_spline_`k'_lr _b[tmax_`spl_varname'_`N_knots'kn_t`k']
{txt} 13{com}.                 global b_T_x_gdp_spline_`k'_lr _b[c.tmax_`spl_varname'_`N_knots'kn_t`k'#c.log_gdp_pc_adm1]
{txt} 14{com}.                 global b_T_x_lrtmax_spline_`k'_lr _b[c.tmax_`spl_varname'_`N_knots'kn_t`k'#c.lr_tmax_p1]
{txt} 15{com}. 
.                 global b_T_spline_`k'_hr _b[1.high_risk#c.tmax_`spl_varname'_`N_knots'kn_t`k']
{txt} 16{com}.                 global b_T_x_gdp_spline_`k'_hr _b[1.high_risk#c.tmax_`spl_varname'_`N_knots'kn_t`k'#c.log_gdp_pc_adm1]
{txt} 17{com}.                 global b_T_x_lrtmax_spline_`k'_hr _b[1.high_risk#c.tmax_`spl_varname'_`N_knots'kn_t`k'#c.lr_tmax_p1]                    
{txt} 18{com}.                 
.                 forval lag=1/6{c -(}
{txt} 19{com}. 
.                         global b_T_spline_`k'_lr ${c -(}b_T_spline_`k'_lr{c )-}+_b[tmax_`spl_varname'_`N_knots'kn_t`k'_v`lag']
{txt} 20{com}.                         global b_T_x_gdp_spline_`k'_lr ${c -(}b_T_x_gdp_spline_`k'_lr{c )-}+_b[c.tmax_`spl_varname'_`N_knots'kn_t`k'_v`lag'#c.log_gdp_pc_adm1]
{txt} 21{com}.                         global b_T_x_lrtmax_spline_`k'_lr ${c -(}b_T_x_lrtmax_spline_`k'_lr{c )-}+_b[c.tmax_`spl_varname'_`N_knots'kn_t`k'_v`lag'#c.lr_tmax_p1]
{txt} 22{com}. 
.                         global b_T_spline_`k'_hr ${c -(}b_T_spline_`k'_hr{c )-}+_b[1.high_risk#c.tmax_`spl_varname'_`N_knots'kn_t`k'_v`lag']
{txt} 23{com}.                         global b_T_x_gdp_spline_`k'_hr ${c -(}b_T_x_gdp_spline_`k'_hr{c )-}+_b[1.high_risk#c.tmax_`spl_varname'_`N_knots'kn_t`k'_v`lag'#c.log_gdp_pc_adm1]
{txt} 24{com}.                         global b_T_x_lrtmax_spline_`k'_hr ${c -(}b_T_x_lrtmax_spline_`k'_hr{c )-}+_b[1.high_risk#c.tmax_`spl_varname'_`N_knots'kn_t`k'_v`lag'#c.lr_tmax_p1]
{txt} 25{com}. 
.                 {c )-}
