.                 #d ;
{txt}delimiter now ;
{com}.                 gl `unint'`i' = "
>                         _b[tmax_rcspl_3kn_t`i'] + 
>                         _b[tmax_rcspl_3kn_t`i'_v1] + 
>                         _b[tmax_rcspl_3kn_t`i'_v2] + 
>                         _b[tmax_rcspl_3kn_t`i'_v3] + 
