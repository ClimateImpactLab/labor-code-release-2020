. * 3x3 plot layout
. cap program drop generate_grids
{txt}
{com}. program define generate_grids
{txt}  1{com}.         
.         args tercile interaction
{txt}  2{com}. 
.         /*      
>         Takes the mean of each tercile (by IR or by rep-unit) of LR climate (tmax)
>         and income (log GDP pc). These are used to define how the 3 x 3 graphs 
>         should be plotted. 
>         */
. 
.         * grid layout: 
.         * -------------
.         * | 7 | 8 | 9 |
.         * -------------
.         * | 4 | 5 | 6 |
.         * -------------
.         * | 1 | 2 | 3 |
.         * -------------
. 
.         if "`tercile'" == "hierid" {c -(}
{txt}  3{com}.                 use "/project/cil/norgay/CIL_labor/2_regression/time_use/input/lrtmax_grid.dta", clear
{txt}  4{com}.                 * generated by emile from the projection system
.                 * long run tmax from CCSM4 rcp8.5, averaged from 1950 to 2005 
.         {c )-}
{txt}  5{com}.         else if "`tercile'" == "rep_unit" {c -(}
{txt}  6{com}.                 use "/project/cil/norgay/CIL_labor/2_regression/time_use/input/rep_unit_terciles_grid.dta", clear
{txt}  7{com}.                 * generated by Kit using gcp-labor/1_preparation/time_use/tercile_by_rep_units.do
.         {c )-}
{txt}  8{com}.         else di "!! Incorrect tercile specification. Permitted: rep_unit, hierid."
{txt}  9{com}. 
.         sum mean_lrtmax, detail
{txt} 10{com}. 
.         local lrtmax_cold=`r(min)'
{txt} 11{com}.         local lrtmax_warm=`r(p50)'
{txt} 12{com}.         local lrtmax_hot=`r(max)'
{txt} 13{com}.         
.         * min, median, and max from data
.         *local lrtmax_cold=6.499815
.         *local lrtmax_warm=27.84472
.         *local lrtmax_hot=33.34956
. 
.         if "`interaction'" == "interacted" | "`interaction'" == "triple_int" {c -(}
{txt} 14{com}. 
.         global max_g = 9
{txt} 15{com}. 
.         global lrtmax1 `lrtmax_cold'
{txt} 16{com}.         global lrtmax2 `lrtmax_warm'
{txt} 17{com}.         global lrtmax3 `lrtmax_hot'
{txt} 18{com}.         global lrtmax4 `lrtmax_cold'
{txt} 19{com}.         global lrtmax5 `lrtmax_warm'
{txt} 20{com}.         global lrtmax6 `lrtmax_hot'
{txt} 21{com}.         global lrtmax7 `lrtmax_cold'
{txt} 22{com}.         global lrtmax8 `lrtmax_warm'
{txt} 23{com}.         global lrtmax9 `lrtmax_hot'
{txt} 24{com}.         
.         {c )-}
{txt} 25{com}. 
.         if "`tercile'" == "hierid" {c -(}
{txt} 26{com}.                 use "/project/cil/norgay/CIL_labor/2_regression/time_use/input/loggdppc_2010_grid.dta", clear
{txt} 27{com}.                 * income generated by tom, also from projection system
.                 * mean of each of the tercile (by impact region) 
.         {c )-}
{txt} 28{com}.         else if "`tercile'" == "rep_unit" {c -(}
{txt} 29{com}.                 use "/project/cil/norgay/CIL_labor/2_regression/time_use/input/rep_unit_terciles_grid.dta", clear
{txt} 30{com}.                 * generated by Kit using gcp-labor/1_preparation/time_use/tercile_by_rep_units
.         {c )-}
{txt} 31{com}.         else di "Incorrect tercile specification. Permitted: rep_unit, hierid."
{txt} 32{com}. 
.         sum mean_loggdppc, detail
{txt} 33{com}. 
.         local inc_poor =`r(min)'
{txt} 34{com}.         local inc_midl =`r(p50)'
{txt} 35{com}.         local inc_rich =`r(max)'
{txt} 36{com}. 
.         * local inc_poor =11.12203
.         * local inc_midl =10.15544
.         * local inc_midl =11.43737
.         * local inc_rich =11.83139
. 
.         if "`interaction'" == "interacted" | "`interaction'" == "triple_int" {c -(}
{txt} 37{com}. 
. 
.                 global minc1 `inc_poor'
{txt} 38{com}.                 global minc2 `inc_poor'
{txt} 39{com}.                 global minc3 `inc_poor'
{txt} 40{com}.                 global minc4 `inc_midl'
{txt} 41{com}.                 global minc5 `inc_midl'
{txt} 42{com}.                 global minc6 `inc_midl'
{txt} 43{com}.                 global minc7 `inc_rich'
{txt} 44{com}.                 global minc8 `inc_rich'
{txt} 45{com}.                 global minc9 `inc_rich'
{txt} 46{com}. 
.                 * define tags that are used to label each plot
.                 global tag1 cold-poor
{txt} 47{com}.                 global tag2 warm-poor
{txt} 48{com}.                 global tag3 hot-poor
{txt} 49{com}.                 global tag4 cold-midincome
{txt} 50{com}.                 global tag5 warm-midincome
{txt} 51{com}.                 global tag6 hot-midincome
{txt} 52{com}.                 global tag7 cold-rich
{txt} 53{com}.                 global tag8 warm-rich
{txt} 54{com}.                 global tag9 hot-rich*
{txt} 55{com}. 
.         {c )-}
{txt} 56{com}. 
.         else if "`interaction'" == "income" {c -(}
{txt} 57{com}. 
.                 di "INTERACTION `interaction'"
{txt} 58{com}. 
.                 global max_g = 3
{txt} 59{com}. 
.                 global minc1 `inc_poor'
{txt} 60{com}.                 global minc2 `inc_midl'
{txt} 61{com}.                 global minc3 `inc_rich'
{txt} 62{com}. 
.         {c )-}
{txt} 63{com}. 
.         * add counts of observations, rep-units, and rep-unit-years.
.         use "/project/cil/norgay/CIL_labor/2_regression/time_use/input/`tercile'_terciles_count.dta", clear
{txt} 64{com}. 
.         if "`interaction'" == "interacted" | "`interaction'" == "triple_int" {c -(}
{txt} 65{com}. 
.                 local i = 1
{txt} 66{com}.                 forvalues inc=1(1)3 {c -(}
{txt} 67{com}.                         forvalues clim=1(1)3 {c -(}
{txt} 68{com}.                                 
.                                 * general counts (consistent across risk subsets)
.                                 sum count_rep_unit if clim == `clim' & inc == `inc'
{txt} 69{com}.                                 if (`r(N)' != 0) gl ru_plot`i' = `r(mean)' 
{txt} 70{com}.                                 else gl ru_plot`i' = 0
{txt} 71{com}. 
.                                 sum count_rep_year if clim == `clim' & inc == `inc'
{txt} 72{com}.                                 if (`r(N)' != 0) gl ry_plot`i' = `r(mean)' 
{txt} 73{com}.                                 else gl ry_plot`i' = 0
{txt} 74{com}. 
.                                 * risk-specific counts (N, varies by low vs high)
.                                 sum count_lr if clim == `clim' & inc == `inc'
{txt} 75{com}.                                 if (`r(N)' != 0) gl risk_lr_plot`i' = `r(mean)' 
{txt} 76{com}.                                 else gl risk_lr_plot`i' = 0
{txt} 77{com}. 
.                                 sum count_hr if clim == `clim' & inc == `inc'
{txt} 78{com}.                                 if (`r(N)' != 0) gl risk_hr_plot`i' = `r(mean)' 
{txt} 79{com}.                                 else gl risk_hr_plot`i' = 0
{txt} 80{com}.                                 
.                                 * total N, sum of HR and LR --> don't worry, I know the shorthand
.                                 * is massively confusing. hr = marginal, hl = high risk.
.                                 global risk_hr_plot`i' = ${c -(}risk_hr_plot`i'{c )-} + ${c -(}risk_lr_plot`i'{c )-}
{txt} 81{com}.                                 local ++i
{txt} 82{com}.                         {c )-}
{txt} 83{com}.                 {c )-}
{txt} 84{com}. 
.         {c )-}
{txt} 85{com}. 
.         else if "`interaction'" == "income" {c -(}
{txt} 86{com}. 
.                 di "INTERACTION `interaction' getting counts"
{txt} 87{com}.                 local i = 1
{txt} 88{com}.                 forvalues inc=1(1)3 {c -(}
{txt} 89{com}.                         * general counts (consistent across risk subsets)
.                                 sum count_rep_unit if inc == `inc'
{txt} 90{com}.                                 if (`r(N)' != 0) gl ru_plot`i' = `r(sum)' 
{txt} 91{com}.                                 else gl ru_plot`i' = 0
{txt} 92{com}. 
.                                 sum count_rep_year if inc == `inc'
{txt} 93{com}.                                 if (`r(N)' != 0) gl ry_plot`i' = `r(sum)' 
{txt} 94{com}.                                 else gl ry_plot`i' = 0
{txt} 95{com}. 
.                                 * risk-specific counts (N, varies by low vs high)
.                                 sum count_lr if inc == `inc'
{txt} 96{com}.                                 if (`r(N)' != 0) gl risk_lr_plot`i' = `r(sum)' 
{txt} 97{com}.                                 else gl risk_lr_plot`i' = 0
{txt} 98{com}. 
.                                 sum count_hr if inc == `inc'
{txt} 99{com}.                                 if (`r(N)' != 0) gl risk_hr_plot`i' = `r(sum)' 
{txt}100{com}.                                 else gl risk_hr_plot`i' = 0
{txt}101{com}.                                 
.                                 * total N, sum of HR and LR --> don't worry, I know the shorthand
.                                 * is massively confusing. hr = marginal, hl = high risk.
.                                 global risk_hr_plot`i' = ${c -(}risk_hr_plot`i'{c )-} + ${c -(}risk_lr_plot`i'{c )-}
{txt}102{com}.                                 local ++i
{txt}103{com}. 
.                 {c )-}
{txt}104{com}.         {c )-}
{txt}105{com}. 
. 
. end
{txt}
{com}. 
