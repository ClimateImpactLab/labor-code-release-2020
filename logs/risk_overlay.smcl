{txt} 34{com}.                                 if("`LL'" == "CT") {c -(}
{txt} 35{com}.                                         loc ll ""
{txt} 36{com}.                                 {c )-}
{txt} 37{com}.                                 if("`LL'" == "lag") {c -(}
{txt} 38{com}.                                         loc ll "_wkn1"
{txt} 39{com}.                                 {c )-}
{txt} 40{com}. 
.                                 * if treatment was not differentiated between high and low risk, gen RF for only low risk
.                                 if "`differentiated_treatment'" == "yes" local risk_list low high
{txt} 41{com}.                                 else local risk_list low
{txt} 42{com}. 
.                                 foreach risk in `risk_list' {c -(}
{txt} 43{com}. 
.                                         if "`risk'" == "high" {c -(}
{txt} 44{com}.                                                 loc risk_tag = "1.high_risk#c."
{txt} 45{com}.                                         {c )-}
{txt} 46{com}.                                         else{c -(}
{txt} 47{com}.                                                 loc risk_tag = ""
{txt} 48{com}.                                         {c )-}
{txt} 49{com}.                                         * Loop over polynomial order 
.                                         forvalues p = 1/`N_order' {c -(}
{txt} 50{com}.                                                 di "`p'"
{txt} 51{com}.                                                 * Loop over leads and lags
.                                                 forvalues v = 0/6{c -(} 
{txt} 52{com}.                                                         if (`v'==0){c -(}
{txt} 53{com}.                                                                 di "`v'"
{txt} 54{com}.                                                                 if("`LL'" == "sum"){c -(}
{txt} 55{com}.                                                                         loc beta_`risk'_t`p' = "_b[`risk_tag'`t_version'_p`p'] + _b[`risk_tag'`t_version'_p`p'_wkn1] + _b[`risk_tag'`t_version'_p`p'_wk1]"
{txt} 56{com}.                                                                 {c )-}
{txt} 57{com}.                                                                 else{c -(}
{txt} 58{com}.                                                                         loc beta_`risk'_t`p' = "_b[`risk_tag'`t_version'_p`p'`ll']"
{txt} 59{com}.                                                                 {c )-}
{txt} 60{com}.                                                         {c )-}
{txt} 61{com}.                                                         else{c -(}
{txt} 62{com}.                                                                 if("`LL'" == "sum"){c -(}
{txt} 63{com}.                                                                         loc beta_`risk'_t`p'  = "`beta_`risk'_t`p'' + _b[`risk_tag'`t_version'_p`p'_v`v'] + _b[`risk_tag'`t_version'_p`p'_wkn1_v`v'] + _b[`risk_tag'`t_version'_p`p'_wk1_v`v']"
{txt} 64{com}.                                                                 {c )-}
{txt} 65{com}.                                                                 else{c -(}
{txt} 66{com}.                                                                         loc beta_`risk'_t`p' = "`beta_`risk'_t`p'' + _b[`risk_tag'`t_version'_p`p'`ll'_v`v']"
{txt} 67{com}.                                                                 {c )-}
{txt} 68{com}.                                                         {c )-}
{txt} 69{com}.                                                 {c )-}
{txt} 70{com}.                                                 di "Sum of coefficients for risk category `risk', polynomial term `p' is ... "
{txt} 71{com}.                                                 di `beta_`risk'_t`p''
{txt} 72{com}.                                         {c )-}
{txt} 73{com}. 
.                                         if ("`risk'" == "low") {c -(}
{txt} 74{com}. 
.                                                 loc predict_command "predictnl yhat_`risk'_`iso' = (`beta_`risk'_t1') * (temp - ref)"
{txt} 75{com}.                                                 forval p = 2/`N_order' {c -(}
{txt} 76{com}.                                                         loc predict_command "`predict_command'  + (`beta_`risk'_t`p'') * (temp ^`p' - ref ^`p') "
{txt} 77{com}.                                                 {c )-}
{txt} 78{com}.                                         {c )-}
{txt} 79{com}.                                                                 
.                                         if ("`risk'" == "high") {c -(}
{txt} 80{com}.                                                 loc predict_command "predictnl yhat_`risk'_`iso' = (`beta_high_t1'+ `beta_low_t1') * (temp - ref)"
{txt} 81{com}.                                                 forval p = 2/`N_order' {c -(}
{txt} 82{com}.                                                         loc predict_command "`predict_command' + (`beta_high_t`p''+ `beta_low_t`p'')  * (temp ^`p' - ref ^`p') "
{txt} 83{com}.                                                 {c )-}
{txt} 84{com}.                                         {c )-}
{txt} 85{com}. 
.                                         di "predicting for `risk' risk"
{txt} 86{com}.                                         loc predict_command "`predict_command' , ci(lowerci_`risk'_`iso' upperci_`risk'_`iso') se(se_`risk'_`iso') p(p_`risk')"
{txt} 87{com}.                                         di "`predict_command'"
{txt} 88{com}.                                         `predict_command'
{txt} 89{com}.                                         gen significant_`risk'_`iso' = 0
{txt} 90{com}.                                         replace significant_`risk'_`iso' = 1 if (lowerci_`risk'_`iso' > 0 | upperci_`risk'_`iso' < 0 )
{txt} 91{com}.                                         
.                                         tempfile `risk'
{txt} 92{com}.                                         save ``risk'', replace 
{txt} 93{com}.                                 {c )-}
{txt} 94{com}. 
.                                 if "`differentiated_treatment'" == "yes" {c -(}
{txt} 95{com}.                                 di "merging high and low risk response functions"
{txt} 96{com}.                                 merge 1:1 temp ref using `low', nogen assert(3)                 
{txt} 97{com}.                                 {c )-}
{txt} 98{com}. 
.                                 cap keep temp ref yhat* se* upper* lower* density significant*
{txt} 99{com}.                                 gen within_R2 = e(r2_within)
{txt}100{com}. 
.                                 * generate a suffix to indicate which ref temperature is being used
.                                 if `ref_temp' == `default_ref_temp' local ref_temp_suffix default_ref 
{txt}101{com}.                                 else local ref_temp_suffix center_ref
{txt}102{com}.                                 * save
.                                 cap mkdir "${c -(}output_dir{c )-}/response_functions/`output_folder'"
{txt}103{com}.                                 cap mkdir "${c -(}output_dir{c )-}/response_functions/`output_folder'/polynomials_`t_version'_`chn_week'"
{txt}104{com}.                                 export delim using "${c -(}output_dir{c )-}/response_functions/`output_folder'/polynomials_`t_version'_`chn_week'/`fe'_poly_`N_order'_`weights'_`data_subset'_`LL'_`ref_temp_suffix'.csv", replace
{txt}105{com}.                         {c )-}
{txt}106{com}.                 {c )-}
{txt}107{com}.         {c )-}
{txt}108{com}.         else{c -(}
{txt}109{com}.         di "the ster file"
{txt}110{com}.         di "`ster_name'.ster"
{txt}111{com}.         di "doesn't exist! check wherther we have run that kind of regression!"
{txt}112{com}. {c )-}
{txt}113{com}. end 
{txt}
{com}. 
. 
. 
