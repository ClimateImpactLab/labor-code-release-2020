. * generate temperature values
. cap program drop generate_temperature
{txt}
{com}. program define generate_temperature
{txt}  1{com}. 
.         args min max ref
{txt}  2{com}. 
.         cap drop if _n > 0
{txt}  3{com}.         cap drop _all
{txt}  4{com}.         cap drop temp
{txt}  5{com}.         gen temp=.
{txt}  6{com}.         local obs = `max' - `min' + 1
{txt}  7{com}.         *expand dataset by length of temperature vector
.         set obs `obs'
{txt}  8{com}.         replace temp = _n - 1 + `min'
{txt}  9{com}.         gen ref = `ref'
{txt} 10{com}.         gen mins_worked = 0
{txt} 11{com}. end
{txt}
{com}. 
. 
. * plot specifications
. cap program drop gen_plot
{txt}
{com}. program define gen_plot 
{txt}  1{com}.         args plot_title g plot_style risk weight 
{txt}  2{com}. 
.         local plot_name = "plot`g'"
{txt}  3{com}.         local range_hr = "-50 80" //original marginal
{txt}  4{com}.         local range_lr = "-20 60"
{txt}  5{com}.         local range_hr = "-50 100"
{txt}  6{com}. 
.         local cutoffs = "xline(${c -(}p1`g'`risk'_`weight'{c )-}, lcol(gold) lpatt(-)) xline(${c -(}p99`g'`risk'_`weight'{c )-}, lcol(gold) lpatt(-)) xline(${c -(}p5`g'`risk'_`weight'{c )-}, lcol(orange) lpatt(_)) xline(${c -(}p95`g'`risk'_`weight'{c )-}, lcol(orange) lpatt(_))"
{txt}  7{com}.         di "`cutoffs'"
{txt}  8{com}.         preserve 
{txt}  9{com}.         if "`plot_style'" == "all_data_with_ci"{c -(}
{txt} 10{com}.                 * all data ci
.                 tw rarea upper_ci lower_ci temp, col(ltbluishgray) || line yhat temp, lc (dknavy) yline(0) `cutoffs' title("`plot_title'") legend(off) ylab(#8,labs(vsmall) ang(vertical)) ytitle("mins worked", size(small)) xlab("",labs(small)) fysize(65) xtitle("") name(`plot_name', replace) graphregion(margin(zero) color(white)) subtitle("${c -(}risk`risk'_`plot_name'{c )-} obs, ${c -(}ru_`plot_name'{c )-} rep-units, ${c -(}ry_`plot_name'{c )-} rep-unit-years.", size(small)) ysc(r(`range`risk'')) xsc(off)
{txt} 11{com}.         {c )-}
{txt} 12{com}.         if "`plot_style'" == "all_data_no_ci"{c -(}
{txt} 13{com}.                 tw  line yhat temp, lc (dknavy) yline(0) `cutoffs' title("`plot_title'") legend(off) ylab(#8,labs(vsmall) ang(vertical)) ytitle("mins worked", size(small)) xlab("",labs(small)) fysize(65) xtitle("") name(`plot_name', replace) graphregion(margin(zero) color(white)) subtitle("${c -(}risk`risk'_`plot_name'{c )-} obs, ${c -(}ru_`plot_name'{c )-} rep-units, ${c -(}ry_`plot_name'{c )-} rep-unit-years.", size(small)) ysc(r(`range`risk'')) xsc(off)
{txt} 14{com}.         {c )-}
{txt} 15{com}. 
.         if "`plot_style'" == "above0_with_ci"{c -(}
{txt} 16{com}.                 drop if temp < 0
{txt} 17{com}.                 tw rarea upper_ci lower_ci temp, col(ltbluishgray) || line yhat temp, lc (dknavy) yline(0) title("`plot_title'") legend(off) graphregion(color(white)) ylabel(,angle(horizontal))  ytitle("mins worked") xtitle("Temperature C", height(6)) name(`plot_name', replace) 
{txt} 18{com}.         {c )-}
{txt} 19{com}.         if "`plot_style'" == "above0_no_ci"{c -(}
{txt} 20{com}.                 drop if temp < 0
{txt} 21{com}.                 tw  line yhat temp, lc (dknavy) yline(0) title("`plot_title'") legend(off) graphregion(color(white)) ylabel(,angle(horizontal))  ytitle("mins worked") xtitle("Temperature C", height(6)) name(`plot_name', replace)
{txt} 22{com}.         {c )-}
{txt} 23{com}.         restore
{txt} 24{com}. end
{txt}
{com}. 
. 
