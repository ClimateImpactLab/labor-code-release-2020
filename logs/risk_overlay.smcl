.                                 if "`differentiated_treatment'" == "yes" local risk_list low high
{txt} 41{com}.                                 else local risk_list low
{txt} 42{com}. 
.                                 foreach risk in `risk_list' {c -(}
{txt} 43{com}. 
.                                         if "`risk'" == "high" {c -(}
{txt} 44{com}.                                                 loc risk_tag = "1.high_risk#c."
{txt} 45{com}.                                         {c )-}
{txt} 46{com}.                                         else{c -(}
