. cap program drop init
{txt}
{com}. program define init 
{txt}  1{com}.         * macro drop _all
.         * clear all
. 
.         set matsize 5000
{txt}  2{com}. 
. 
.         cap log close
{txt}  3{com}.         set more off
{txt}  4{com}.         *cap ssc install parallel
. 
.         if "`c(hostname)'" == "battuta" {c -(}
{txt}  5{com}.                 global shares_path "/project/cil/sacagawea_shares"
{txt}  6{com}.         {c )-}
{txt}  7{com}.         else global shares_path "/shares"
{txt}  8{com}.         *local path `c(pwd)'
.         *global code_dir `path'
. 
.         global data_dir "${c -(}shares_path{c )-}/gcp/estimation/labor/time_use_data/final"
{txt}  9{com}.         global output_dir "${c -(}shares_path{c )-}/gcp/estimation/labor/regression_results" 
{txt} 10{com}. 
.         global clustering_var cluster_adm1yymm
{txt} 11{com}.         global weights_var risk_adj_sample_wgt
{txt} 12{com}. 
.         global bin_step 0.1
{txt} 13{com}.         
. end 
{txt}
{com}. *log using "${c -(}code_dir{c )-}/parallel", replace text
. 
. cap program drop run_specification
{txt}
{com}. program define run_specification
{txt}  1{com}. 
.         args reg_method spec_desc data include_0_min treatment control diff_treat diff_cont fe_ver weights clustering_var ster_name suffix
{txt}  2{com}. 
.         local FE_dummies `fe_ver'
{txt}  3{com}. 
. 
.         if "`clustering'" == "no_clustering" {c -(}
{txt}  4{com}.                 local clustering 
{txt}  5{com}.         {c )-}
{txt}  6{com}.         else {c -(}
{txt}  7{com}.                 local clustering cl `clustering_var'
{txt}  8{com}.         {c )-}
{txt}  9{com}. 
.         if "`diff_treat'" == "diff_treat"{c -(}
{txt} 10{com}.                 local treatment (`treatment')##i.high_risk
{txt} 11{com}.         {c )-}
{txt} 12{com}. 
.         if "`diff_cont'" == "diff_cont"{c -(}
{txt} 13{com}.                 local control (`control')##i.high_risk
{txt} 14{com}.                 local fe 
{txt} 15{com}.                 foreach f in ${c -(}`fe_ver'{c )-} {c -(}
{txt} 16{com}.                         local fe `fe' `f'#high_risk
{txt} 17{com}.                 {c )-}
{txt} 18{com}.         {c )-}
{txt} 19{com}. 
. 
. 
.         if "`include_0_min'" != "include_0_min" keep if mins_worked > 0
{txt} 20{com}. 
. 
.         if "`reg_method'" == "reg"{c -(}
{txt} 21{com}.                 timer on 1 
{txt} 22{com}.                 * if we want run using reg, we need to turn the FEs into dummies
.                 * we create the FE group variables after loading the data
.                 * and pass a list of dummies e.g. i.g1 i.g2 i.g3
.                 * to the same argument as FE in the reghdfe case
. 
.                 di "reg mins_worked `treatment' `control' `FE_dummies' [pweight = `weights'] if included == 1, cluster(`clustering_var')"
{txt} 23{com}.                 qui reg mins_worked `treatment' `control' `FE_dummies' [pweight = `weights'] if included == 1, cluster(`clustering_var')
{txt} 24{com}.                 estimates notes: "`spec_desc'"
{txt} 25{com}.                 estimates save "`ster_name'_reg", replace       
{txt} 26{com}.                 *di _b[tmax_p1] 
.                 *di _se[tmax_p1]
. 
.                 timer off 1 
{txt} 27{com}. 
.                 timer list 1
{txt} 28{com}. 
.                 local time = `r(t1)'
{txt} 29{com}.                 local div = 3600
{txt} 30{com}.                 local time_hours = `time'/`div'
{txt} 31{com}. 
.                 di "the specification took `time_hours' hours to run"
{txt} 32{com}.         {c )-}
{txt} 33{com}. 
.         if "`reg_method'" == "reghdfe"{c -(}
{txt} 34{com}.                 timer on 2
{txt} 35{com}. 
.                 di "reghdfe mins_worked `treatment' `control' [pweight = `weights'], absorb(`fe') vce(`clustering')"
{txt} 36{com}.                 qui reghdfe mins_worked `treatment' `control' [pweight = `weights'], absorb(`fe') vce(`clustering')
{txt} 37{com}.                 estimates notes: "`spec_desc'"
{txt} 38{com}.                 estimates save "`ster_name'_reghdfe", replace   
{txt} 39{com}.                 *di _b[tmax_p1]
.                 *di _se[tmax_p1]
.                 timer off 2 
{txt} 40{com}. 
.                 timer list 2
{txt} 41{com}. 
.                 local time = `r(t2)'
{txt} 42{com}.                 local div = 3600
{txt} 43{com}.                 local time_hours = `time'/`div'
{txt} 44{com}. 
.                 di "the specification took `time_hours' hours to run"
{txt} 45{com}.         {c )-}
{txt} 46{com}. 
. 
. 
. 
. end
{txt}
{com}. 
