{com}. gl rf_folder "${c -(}DIR_OUTPUT{c )-}/interacted_reg_output"
{txt}
{com}. 
. 
. *****************
. *       MAKE PLOTS
. *****************
. 
. * other selections
. 
. local N_knots 3 
{txt}
{com}. 
. global reg_list 1_factor_2025
{txt}
{com}. * takes: 1_factor 2_factor
. 
. global data_subset_list no_chn
{txt}
{com}. *global data_subset_list FRA GBR ESP IND CHN USA BRA MEX EU daily weekly no_chn all_data 
. 
. global weights_list rep_unit_year_sample_wgt
{txt}
{com}. 
. global fe_list fe_week_adm0 
{txt}
{com}. 
. global interaction "income"
{txt}
{com}. * takes: interacted, income, triple_int
. 
. global tercile rep_unit
{txt}
{com}. * takes: rep_unit, hierid
. 
. global hist_weight_list rep_unit_year_sample_wgt
{txt}
{com}. * takes: no_wgt rep_unit_year_sample_wgt
. 
. global hist_style_list abs pct
{txt}
{com}. 
. global max_g 9
{txt}
{com}. * takes 3 and 9
. 
. foreach weight in $hist_weight_list {c -(}
