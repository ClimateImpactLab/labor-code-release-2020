. cap program drop select_data_subset 
{txt}
{com}. program define select_data_subset 
{txt}  1{com}.         args data_subset
{txt}  2{com}.         local countries "BRA CHN MEX IND USA FRA ESP GBR"
{txt}  3{com}.         * get climate/income terciles and quartiles for subsetting
.         merge m:1 rep_unit using "${c -(}ROOT_INT_DATA{c )-}/xtiles/rep_unit_terciles_uncollapsed.dta", keepusing(inc_t clim_t inc_q clim_q) nogen
{txt}  4{com}. 
.         if "`data_subset'"=="weekly" keep if iso=="BRA"|iso=="CHN"|iso=="MEX"
{txt}  5{com}.         else if "`data_subset'"=="daily" drop if iso=="BRA"|iso=="CHN"|iso=="MEX"
{txt}  6{com}.         else if "`data_subset'"=="EU" keep if iso=="ESP"|iso=="FRA"|iso=="GBR"  
{txt}  7{com}.         else if "`data_subset'"=="no_chn" drop if iso=="CHN"    
{txt}  8{com}.         else if "`data_subset'" == "CHN_mon" keep if iso == "CHN" & dow == 1
{txt}  9{com}.         else if "`data_subset'" == "CHN_tue" keep if iso == "CHN" & dow == 2
{txt} 10{com}.         else if "`data_subset'" == "CHN_wed" keep if iso == "CHN" & dow == 3
{txt} 11{com}.         else if "`data_subset'" == "CHN_thu" keep if iso == "CHN" & dow == 4
{txt} 12{com}.         else if "`data_subset'" == "CHN_fri" keep if iso == "CHN" & dow == 5
{txt} 13{com}.         else if "`data_subset'" == "CHN_sat" keep if iso == "CHN" & dow == 6
{txt} 14{com}.         else if "`data_subset'" == "CHN_sun" keep if iso == "CHN" & dow == 0
{txt} 15{com}.         foreach country in `countries' {c -(}
{txt} 16{com}.                 else if "`data_subset'" == "no_`country'" keep if iso != "`country'"
{txt} 17{com}.         {c )-}
{txt} 18{com}.         else if "`data_subset'"!= "all_data" & inlist("`data_subset'", "BRA","CHN","MEX","IND","USA","FRA","ESP","GBR") {c -(}
{txt} 19{com}.                 keep if iso == "`data_subset'"
{txt} 20{com}.         {c )-}
{txt} 21{com}.         * these are the tercile stuffs
.         else if "`data_subset'" == "inc_t1" keep if iso!= "CHN" & inc_t == 1
{txt} 22{com}.         else if "`data_subset'" == "inc_t2" keep if iso!= "CHN" & inc_t == 2
{txt} 23{com}.         else if "`data_subset'" == "inc_t3" keep if iso!= "CHN" & inc_t == 3
{txt} 24{com}.         else if "`data_subset'" == "clim_t1" keep if iso!= "CHN" & clim_t == 1
{txt} 25{com}.         else if "`data_subset'" == "clim_t2" keep if iso!= "CHN" & clim_t == 2
{txt} 26{com}.         else if "`data_subset'" == "clim_t3" keep if iso!= "CHN" & clim_t == 3
{txt} 27{com}.         else if "`data_subset'" == "inc_q1_clim_q1" keep if  iso!= "CHN" & inc_q == 1 & clim_q == 1
{txt} 28{com}.         else if "`data_subset'" == "inc_q1_clim_q2" keep if  iso!= "CHN" & inc_q == 1 & clim_q == 2
{txt} 29{com}.         else if "`data_subset'" == "inc_q2_clim_q1" keep if  iso!= "CHN" & inc_q == 2 & clim_q == 1
{txt} 30{com}.         else if "`data_subset'" == "inc_q2_clim_q2" keep if  iso!= "CHN" & inc_q == 2 & clim_q == 2
{txt} 31{com}.         else if "`data_subset'" != "all_data" di "wrong specification of data scope!"
{txt} 32{com}. end // note that "wrong specification of scope" keeps showing up incorrectly
{txt}
{com}. 
. 
. cap program drop get_RF_uninteracted_splines
{txt}
{com}. program define get_RF_uninteracted_splines
{txt}  1{com}.         args leads_lags differentiated_treatment ster_name filename_stem t_version chn_week spl_varname fe N_knots knots_loc weights data_subset output_folder default_ref_temp
{txt}  2{com}.         
.         di "get RF for uninteracted splines"
{txt}  3{com}.         * determine the list of RFs to generate based on if the regression includes lead and lag weeks
.         if "`leads_lags'" == "all_weeks" global LL_list lead lag sum CT
{txt}  4{com}.         else if "`leads_lags'" == "this_week" global LL_list CTO
{txt}  5{com}.         else di "misspecified leads_lags week"
{txt}  6{com}. 
.         * find the range and mean of the subset of data
.         * if the spline dataset didn't contain china data, use the distribution of temperatures from the dataset with chn_prev7days
.         if "`chn_week'" == "no_chn" local chn_week_temp_distribution chn_prev7days
{txt}  7{com}.         else local chn_week_temp_distribution `chn_week'
{txt}  8{com}.         import delim using "$data_dir/temp_distributions/`t_version'_`chn_week_temp_distribution'/`data_subset'.csv", clear
{txt}  9{com}.         tempfile bins
{txt} 10{com}.         save `bins', replace
{txt} 11{com}. 
.         sum max_realised, meanonly
{txt} 12{com}.         loc max_realised = r(mean)
{txt} 13{com}.         sum min_realised, meanonly
{txt} 14{com}.         loc min_realised = r(mean)
{txt} 15{com}.         sum center, meanonly
{txt} 16{com}.         loc center = r(mean)
{txt} 17{com}. 
.         local obs = ( `max_realised' - `min_realised' + 1 ) / $bin_step
{txt} 18{com}. 
. 
.         di "`ster_name'.ster"
{txt} 19{com}. 
.         * Note - we need one less term than the number of knots
.         capture confirm file "`ster_name'.ster"
{txt} 20{com}.         if _rc == 0 {c -(} 
{txt} 21{com}.                 
.                 estimates use "`ster_name'.ster"
{txt} 22{com}. 
.                 local knots ${c -(}`knots_loc'{c )-}
{txt} 23{com}.                 di "`knots'"
{txt} 24{com}. 
.                 local knot1 : word 1 of `knots'
{txt} 25{com}.                 local knot2 : word 2 of `knots'
{txt} 26{com}.                 local knot3 : word 3 of `knots'
{txt} 27{com}.                 loc knot_string = "`knot1'_`knot2'_`knot3'_"
{txt} 28{com}. 
. 
.                 foreach LL in $LL_list {c -(}                
{txt} 29{com}.                         foreach ref_temp in `center' `default_ref_temp' {c -(}       
{txt} 30{com}.                                 clear 
{txt} 31{com}.                                 gen temp=.
{txt} 32{com}.                                 set obs `obs'
{txt} 33{com}.                                 gen ref = `ref_temp'
{txt} 34{com}.                                 * generate temperature vector within the range of the data
.                                 replace temp = `min_realised' + $bin_step * (_n - 1)  + ($bin_step / 2)
{txt} 35{com}.                                 gen mins_worked = .
{txt} 36{com}.                                 qui merge 1:1 temp using `bins'
{txt} 37{com}.                                 replace density= 0 if _merge == 1
{txt} 38{com}.                                 assert _merge != 2
{txt} 39{com}.                                 drop _merge
{txt} 40{com}. 
. 
.                                 make_spline_terms `knot1' `knot2' `knot3'
{txt} 41{com}.                                 
.                                 * Get the relevant variable name tag
.                                 if("`LL'" == "lead") {c -(}
{txt} 42{com}.                                         loc ll "_wk1"
{txt} 43{com}.                                 {c )-}
{txt} 44{com}.                                 if("`LL'" == "CT") {c -(}
{txt} 45{com}.                                         loc ll ""
{txt} 46{com}.                                 {c )-}
{txt} 47{com}.                                 if("`LL'" == "lag") {c -(}
{txt} 48{com}.                                         loc ll "_wkn1"
{txt} 49{com}.                                 {c )-}
{txt} 50{com}.                                 
. 
.                                 * if treatment was not differentiated between high and low risk, gen RF for only low risk
.                                 if "`differentiated_treatment'" == "yes" local risk_list low high
{txt} 51{com}.                                 else local risk_list low
{txt} 52{com}. 
.                                 foreach risk in `risk_list' {c -(}
{txt} 53{com}. 
.                                         if "`risk'" == "high" {c -(}
{txt} 54{com}.                                                 loc risk_tag = "1.high_risk#c."
{txt} 55{com}.                                         {c )-}
{txt} 56{com}.                                         else{c -(}
{txt} 57{com}.                                                 loc risk_tag = ""
{txt} 58{com}.                                         {c )-}
{txt} 59{com}.                                         di "checker - made it to point 1"
{txt} 60{com}.                                         * Loop over polynomial order 
. 
.                                         loc max_spline_term =`N_knots' - 2
{txt} 61{com}.                                         forvalues p = 0/`max_spline_term' {c -(}
{txt} 62{com}.                                                 di "`p'"
{txt} 63{com}.                                                 * Loop over leads and lags
.                                                 forvalues v = 0/6{c -(} 
{txt} 64{com}.                                                         if (`v'==0){c -(}
{txt} 65{com}.                                                                 di "`v'"
{txt} 66{com}.                                                                 if("`LL'" == "sum"){c -(}
{txt} 67{com}.                                                                         loc beta_`risk'_t`p' = "_b[`risk_tag'`t_version'_`spl_varname'_3kn_t`p'] + _b[`risk_tag'`t_version'_`spl_varname'_3kn_t`p'_wkn1] + _b[`risk_tag'`t_version'_`spl_varname'_3kn_t`p'_wk1] "
{txt} 68{com}.                                                                 {c )-}
{txt} 69{com}.                                                                 else{c -(}
{txt} 70{com}.                                                                         loc beta_`risk'_t`p' =  "_b[`risk_tag'`t_version'_`spl_varname'_3kn_t`p'`ll'] "
{txt} 71{com}.                                                                 {c )-}
{txt} 72{com}.                                                         {c )-}
{txt} 73{com}.                                                         else{c -(}
{txt} 74{com}.                                                                 if("`LL'" == "sum"){c -(}
{txt} 75{com}.                                                                         loc beta_`risk'_t`p'  = "`beta_`risk'_t`p'' + _b[`risk_tag'`t_version'_`spl_varname'_3kn_t`p'_v`v'] + _b[`risk_tag'`t_version'_`spl_varname'_3kn_t`p'_wkn1_v`v'] + _b[`risk_tag'`t_version'_`spl_varname'_3kn_t`p'_wk1_v`v']"
{txt} 76{com}.                                                                 {c )-}
{txt} 77{com}.                                                                 else{c -(}
{txt} 78{com}.                                                                         loc beta_`risk'_t`p' = "`beta_`risk'_t`p'' + _b[`risk_tag'`t_version'_`spl_varname'_3kn_t`p'`ll'_v`v']"
{txt} 79{com}.                                                                 {c )-}
{txt} 80{com}.                                                         {c )-}
{txt} 81{com}.                                                 {c )-}
{txt} 82{com}.                                                 di "Sum of coefficients for risk category `risk', spline term `p' is ... "
{txt} 83{com}.                                                 di `beta_`risk'_t`p''
{txt} 84{com}.                                         {c )-}
{txt} 85{com}. 
.                                         if("`risk'" == "low") {c -(}
{txt} 86{com}. 
.                                                 loc predict_command "predictnl yhat_`risk'_`iso' = (`beta_`risk'_t0') * (T_spline0 - ref_spline0)"
{txt} 87{com}.                                                 forval p = 1/`max_spline_term'  {c -(}
{txt} 88{com}.                                                         loc predict_command "`predict_command'  + (`beta_`risk'_t`p'') * (T_spline`p' - ref_spline`p') "
{txt} 89{com}.                                                 {c )-}
{txt} 90{com}.                                         {c )-}
{txt} 91{com}.                                                                 
.                                         if("`risk'" == "high") {c -(}
{txt} 92{com}.                                                 loc predict_command "predictnl yhat_`risk'_`iso' = (`beta_high_t0'+ `beta_low_t0') * (T_spline0 - ref_spline0)"
{txt} 93{com}.                                                 forval p = 1/`max_spline_term'  {c -(}
{txt} 94{com}.                                                         loc predict_command "`predict_command' + (`beta_high_t`p''+ `beta_low_t`p'')  * (T_spline`p' - ref_spline`p') "
{txt} 95{com}.                                                 {c )-}
{txt} 96{com}.                                         {c )-}
{txt} 97{com}.                                         di "predicting for `risk' risk"
{txt} 98{com}.                                         di "`predict_command'"
{txt} 99{com}.                                         `predict_command', ci(lowerci_`risk'_`iso' upperci_`risk'_`iso') se(se_`risk'_`iso')
{txt}100{com}.                                         gen significant_`risk'_`iso' = 0
{txt}101{com}.                                         replace significant_`risk'_`iso' = 1 if (lowerci_`risk'_`iso' > 0 | upperci_`risk'_`iso' < 0 )
{txt}102{com}.                                         
.                                         tempfile `risk'
{txt}103{com}.                                         save ``risk'', replace 
{txt}104{com}.                                 {c )-}
{txt}105{com}. 
. 
.                                 if "`differentiated_treatment'" == "yes" {c -(}
{txt}106{com}.                                 di "merging high and low risk response functions"
{txt}107{com}.                                 merge 1:1 temp ref using `low', nogen assert(3)                 
{txt}108{com}.                                 {c )-}
{txt}109{com}. 
.                                 keep temp ref yhat* se* upper* lower* density* significant* rep_unit_year_sample_wgt
{txt}110{com}. 
.                                 gen within_R2 = e(r2_within)
{txt}111{com}.                         
.                                 * generate a suffix to indicate which ref temperature is being used
.                                 if `ref_temp' == `default_ref_temp' local ref_temp_suffix default_ref 
{txt}112{com}.                                 else local ref_temp_suffix center_ref
{txt}113{com}.                                 * save
.                                 cap mkdir "${c -(}output_dir{c )-}/response_functions/`output_folder'"
{txt}114{com}.                                 cap mkdir "${c -(}output_dir{c )-}/response_functions/`output_folder'/`filename_stem'_`t_version'_`chn_week'"
{txt}115{com}.                                 export delim using "${c -(}output_dir{c )-}/response_functions/`output_folder'/`filename_stem'_`t_version'_`chn_week'/`fe'_`N_knots'_knots_`data_subset'_`weights'_`LL'_`ref_temp_suffix'.csv", replace
{txt}116{com}.                         {c )-}
{txt}117{com}.                 {c )-}
{txt}118{com}.         {c )-}
{txt}119{com}.         else{c -(}
{txt}120{com}.                 di "the ster..."
{txt}121{com}.                 di "`ster_name'.ster"
{txt}122{com}.                 di "doesn't exist! check wherther we have run that kind of regression!"
{txt}123{com}.         {c )-}
{txt}124{com}. end 
{txt}
{com}. 
