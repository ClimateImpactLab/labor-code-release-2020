.         di "${c -(}varlist_bins_${c -(}bin_width{c )-}{c )-}"
{txt} 14{com}. end   
{txt}
{com}. 
. 
. ***************************************
. *       MAKE_TEMP_DIST
. 
. *       make a list of temps accordingly
. ***************************************
. 
. cap prog drop make_temp_dist
{txt}
{com}. prog def make_temp_dist
{txt}  1{com}.         syntax , list(numlist) ref(real)
{txt}  2{com}. 
.         loc num : word count `list'
{txt}  3{com}.         set obs `num'
{txt}  4{com}. 
.         gen temp = .
{txt}  5{com}.         gen ref = `ref'
{txt}  6{com}. 
.         loc i = 1
{txt}  7{com}.         foreach temp in `list' {c -(}
{txt}  8{com}.                 replace temp = `temp' in `i'
{txt}  9{com}.                 loc ++i
{txt} 10{com}.         {c )-}
{txt} 11{com}. 
. end
{txt}
{com}. 
. 
. ***************************************
. *       MAKE_SPLINE_TERMS
. 
. *       generate interpretable spline versions
. ***************************************
. 
. cap program drop make_spline_terms
{txt}
{com}. program define make_spline_terms
{txt}  1{com}.         args knot1 knot2 knot3
{txt}  2{com}. 
.         glob knots = "`knot1' `knot2' `knot3'"
{txt}  3{com}. 
.         local scaling_factor=(`knot3'-`knot1')^2
{txt}  4{com}.         mkspline T_spline=temp, cubic knots($knots)
{txt}  5{com}.         mkspline ref_spline=ref, cubic knots($knots)
{txt}  6{com}. 
.         di "matching these splines with the transformed-after-aggregated data"
{txt}  7{com}. 
.         forval k=2/2{c -(}
{txt}  8{com}.                 replace T_spline`k'=T_spline`k'*`scaling_factor'
{txt}  9{com}.                 replace ref_spline`k'=ref_spline`k'*`scaling_factor'
{txt} 10{com}.         {c )-}
{txt} 11{com}. 
.         forval k = 1/2{c -(}
{txt} 12{com}.                 loc j = `k' - 1
{txt} 13{com}.                 ren T_spline`k' T_spline`j'
{txt} 14{com}.                 ren ref_spline`k' ref_spline`j'
{txt} 15{com}.         {c )-}
{txt} 16{com}. end 
{txt}
{com}. 
. 
. ***************************************
