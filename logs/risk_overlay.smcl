. **************************************
. ***** OVERLAY SPECIFIC FUNCTIONS *****
. **************************************
. 
. * generate response function
. cap program drop gen_response_overlay
{txt}
{com}. program define gen_response_overlay
{txt}  1{com}. 
.         args N_knots risk grid
{txt}  2{com}. 
.         * N_new_vars = 1 in 3 knots case
.         local N_new_vars=`N_knots'-2 
{txt}  3{com}.         global response_surface 0
{txt}  4{com}.         * i = 0/1
.         * sum up the terms in the response function
.         forval i=0/`N_new_vars'{c -(}
{txt}  5{com}.                 gl response_surface ${c -(}response_surface{c )-}+(${c -(}b_T_spline_`i'`risk'{c )-})*(T_spline`i'-T_ref_spline`i')
{txt}  6{com}.                 gl response_surface ${c -(}response_surface{c )-}+(${c -(}b_T_x_gdp_spline_`i'`risk'{c )-})*(T_spline`i'-T_ref_spline`i')*${c -(}minc`grid'{c )-}
{txt}  7{com}.                 if "$interaction" == "interacted" |  "$interaction" == "triple_int" {c -(}
{txt}  8{com}.                         gl response_surface ${c -(}response_surface{c )-}+(${c -(}b_T_x_lrtmax_spline_`i'`risk'{c )-})*(T_spline`i'-T_ref_spline`i')*${c -(}lrtmax`grid'{c )-}
{txt}  9{com}.                 {c )-}
{txt} 10{com}.                 if "$interaction" == "triple_int" {c -(}
{txt} 11{com}.                         gl response_surface ${c -(}response_surface{c )-}+(${c -(}b_T_x_gdp_x_lrtmax_spline_`i'`risk'{c )-})*(T_spline`i'-T_ref_spline`i')*${c -(}minc`grid'{c )-}*${c -(}lrtmax`grid'{c )-}
{txt} 12{com}.                 {c )-}
{txt} 13{com}. 
.         {c )-}
{txt} 14{com}.         cap drop yhat`risk' *_ci`risk'
{txt} 15{com}.         di "`risk' `grid': $response_surface"
{txt} 16{com}.         predictnl yhat`risk' = $response_surface, ci(lower_ci`risk' upper_ci`risk')
{txt} 17{com}.         tempfile `risk'
{txt} 18{com}.         save ``risk'', replace 
{txt} 19{com}. 
.         import delim using "${c -(}DIR_OUTPUT{c )-}/rf/uninteracted_reg_comlohi/uninteracted_reg_comlohi_full_response.csv", clear
{txt} 20{com}.         merge 1:1 temp using ``risk'' , nogen keep(3)
{txt} 21{com}. 
. end
{txt}
{com}. 
. * generate plot
. cap program drop gen_plot_overlay
{txt}
{com}. program define gen_plot_overlay 
{txt}  1{com}.         args plot_title g plot_style weight 
{txt}  2{com}. 
.         local plot_name = "plot`g'"
{txt}  3{com}.         local range_overlay = "-50 100"
{txt}  4{com}. 
.         local cutoffs = "xline(${c -(}p1`g'`risk'_`weight'{c )-}, lcol(gold) lpatt(-)) xline(${c -(}p99`g'`risk'_`weight'{c )-}, lcol(gold) lpatt(-)) xline(${c -(}p5`g'`risk'_`weight'{c )-}, lcol(orange) lpatt(_)) xline(${c -(}p95`g'`risk'_`weight'{c )-}, lcol(orange) lpatt(_))"
{txt}  5{com}.         * di "`cutoffs'"
.         preserve 
{txt}  6{com}.         if "`plot_style'" == "all_data_with_ci"{c -(}
{txt}  7{com}.                 * all data ci
.                 tw rarea upper_ci lower_ci temp, col(ltbluishgray) || line yhat temp, lc (dknavy) yline(0) `cutoffs' title("`plot_title'") legend(off) ylab(#8,labs(vsmall) ang(vertical)) ytitle("mins worked", size(small)) xlab("",labs(small)) fysize(65) xtitle("") name(`plot_name', replace) graphregion(margin(zero) color(white)) subtitle("${c -(}risk`risk'_`plot_name'{c )-} obs, ${c -(}ru_`plot_name'{c )-} rep-units, ${c -(}ry_`plot_name'{c )-} rep-unit-years.", size(small)) ysc(r(`range`risk'')) xsc(off)
{txt}  8{com}.         {c )-}
{txt}  9{com}.         if "`plot_style'" == "all_data_no_ci"{c -(}
{txt} 10{com}.                 tw line yhat_low yhat_hl temp, yline(0, lcol(black) lpattern(dot)) title("`plot_title'") legend(label(1 "unint low risk") label(2 "int 1_factor high risk") size(small) symxsize(*.5) cols(1)) ylab(#10,labs(vsmall) ang(vertical)) ytitle("mins worked", size(small)) xlab(#10,labs(vsmall)) xmtick(##2) xtitle("temperature", size(small)) name(`plot_name', replace) graphregion(margin(zero) color(white)) subtitle("${c -(}ru_`plot_name'{c )-} rep-units, ${c -(}ry_`plot_name'{c )-} rep-unit-years.", size(small)) ysc(r(`range_overlay')) xsc(r(-20(5)60)) 
{txt} 11{com}.         {c )-}
{txt} 12{com}.         restore
{txt} 13{com}. end
{txt}
{com}. 
. * call the other functions to put together the plots
. cap program drop plot_interacted_spline_overlay
{txt}
{com}. program define plot_interacted_spline_overlay
{txt}  1{com}.         args interaction f N_knots data_subset plot_style ster_name
{txt}  2{com}. 
.         cd "${c -(}DIR_OUTPUT{c )-}/diagnostics"
{txt}  3{com}.         cap mkdir "plankpose_diagnostics"
{txt}  4{com}.         cd "plankpose_diagnostics"
{txt}  5{com}.         
.         di "Using: ${c -(}ster_dir{c )-}/`ster_name'.ster"
{txt}  6{com}.         estimates use "${c -(}ster_dir{c )-}/`ster_name'.ster"
{txt}  7{com}. 
.         generate_temperature -20 50 27
{txt}  8{com}.         spline_temperature_range 3
{txt}  9{com}. 
.         if "`interaction'" == "income" loc size = 50
{txt} 10{com}.         else loc size = 20
{txt} 11{com}. 
.         di "INTERACTION : `interaction' `size'"
{txt} 12{com}. 
.         * lr: low risk, hr: high risk (risk interaction terms only), hl: lr + hr = response of high risk 
.         foreach risk in _hl {c -(}
{txt} 13{com}.                 * generate the 3 or 9 plots
.                 forval g = 1/$max_g {c -(}
{txt} 14{com}.                         gen_response_overlay `N_knots' `risk' `g' 
{txt} 15{com}.                         gen_plot_overlay "${c -(}tag`g'{c )-}" `g' `plot_style' `risk' 
{txt} 16{com}.                 {c )-}
{txt} 17{com}.                 local plot_tag overlaid_high_1factor_low_unint_response
{txt} 18{com}.                 
.                 if "`interaction'" != "income" {c -(}
{txt} 19{com}.                         graph combine plot7 plot8 plot9 plot4 plot5 plot6 plot1 plot2 plot3, plotregion(color(white)) graphregion(color(white) margin(t=5 b=5)) xcomm imargin(0 0 0 0) cols(3) title("`plot_tag'") subtitle("`ster_name'", size(vsmall))
{txt} 20{com}.                 {c )-}
{txt} 21{com}.                 else {c -(}
{txt} 22{com}.                         graph combine plot1 plot2 plot3, plotregion(color(white)) graphregion(color(white) margin(t=5 b=5)) xcomm imargin(0 0 0 0) cols(3) title("`plot_tag'") subtitle("`ster_name'", size(vsmall))
{txt} 23{com}.                 {c )-}
{txt} 24{com}.                 graph export "`ster_name'_`plot_tag'.pdf", replace
{txt} 25{com}.         {c )-}
{txt} 26{com}. 
.         cd ..
{txt} 27{com}. end
{txt}
{com}. 
