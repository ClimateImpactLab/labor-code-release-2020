{txt} 23{com}.                         global b_T_x_gdp_spline_`k'_hr ${c -(}b_T_x_gdp_spline_`k'_hr{c )-}+_b[1.high_risk#c.tmax_`spl_varname'_`N_knots'kn_t`k'_v`lag'#c.log_gdp_pc_adm1]
