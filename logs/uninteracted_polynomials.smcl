{smcl}
{com}{sf}{ul off}{txt}{.-}
      name:  {res}<unnamed>
       {txt}log:  {res}/project/cil/home_dirs/maiqi/repos/labor-code-release-2020/logs/uninteracted_polynomials.smcl
  {txt}log type:  {res}smcl
 {txt}opened on:  {res}15 Dec 2025, 23:34:58

{com}. 
. * other selections

. gl test_code "no"

. loc fe fe_adm0_wk

. 
. gl reg_list nochn

. 
. * ---------- CHOOSE WHICH RISK DEFINITION TO USE ----------

. * options: "high_risk" or "high_risk_old"

. global risk_def "high_risk" 

. * ---------------------------------------------------------

. 
. ****************************************

. *RUN REGRESSION - WITH AND WITHOUT CHINA

. ****************************************

. 
. * with and without China

. foreach reg in $reg_list {c -(}
{txt}  2{com}. 
. * for each order of polynomial in 2, 3, 4
. forval N_order=4(1)4 {c -(}
{txt}  3{com}. 
. * select dataset and output folder
. gl dataset "/project/cil/battuta_shares/gcp/estimation/labor/code_release_int_data/regression_ready_data/z_old/labor_dataset_polynomials_nochn_tmax_chn_prev_week_no_ll_0.dta"
{txt}  4{com}. cap mkdir "${c -(}DIR_STER{c )-}/uninteracted_polynomials"
{txt}  5{com}. loc reg_folder "${c -(}DIR_STER{c )-}/uninteracted_polynomials"
{txt}  6{com}. 
. use $dataset, clear
{txt}  7{com}. 
. * if test code mode is on, take a random sample
. if "${c -(}test_code{c )-}"=="yes" {c -(}
{txt}  8{com}. sample 0.1
{txt}  9{com}. {c )-}
{txt} 10{com}. 
. * only include non-zero observations
. keep if mins_worked > 0
{txt} 11{com}. 
. * ---------- DEFINE risk_level FROM CHOSEN SOURCE ----------
. cap drop risk_level 
{txt} 12{com}. gen risk_level = .   
{txt} 13{com}. replace risk_level = high_risk     if "${c -(}risk_def{c )-}"=="high_risk"
{txt} 14{com}. *replace risk_level = high_risk_old if "${c -(}risk_def{c )-}"=="high_risk_old"
. *replace risk_level = sector if "${c -(}risk_def{c )-}"=="sector"
. *replace risk_level = occup_code if "${c -(}risk_def{c )-}"=="occup_code"
. 
. * generate regression variables
. gen_controls_and_FEs
{txt} 15{com}. gen_treatment_polynomials `N_order' tmax this_week 1
{txt} 16{com}. 
. * differentiate treatment if reg is by risk
. loc reg_treatment (${c -(}vars_T_polynomials{c )-})##i.risk_level
{txt} 17{com}. * both regressions have interacted controls
. local reg_control (${c -(}usual_controls{c )-})##i.risk_level
{txt} 18{com}. 
. * interact each fixed effect with the risk binary
. local reg_fe "adm3_id#risk_level dow_week#risk_level adm0_id#year#risk_level adm0_id#week_fe#risk_level"
{txt} 19{com}. 
. 
. * -------------------------------------------------------------------------------------------------------
. * set the ster file name and the notes to be included
. local ster_name "`reg_folder'/uninteracted_polynomials_`reg'_`N_order'_2025_oldold.ster"
{txt} 20{com}. local spec_desc "polynomial, uninteracted_polynomials_`reg', order = `N_order', tmax, differentiated treatment, fe = `fe'"
{txt} 21{com}. * -------------------------------------------------------------------------------------------------------
. di "reghdfe mins_worked `reg_treatment' `reg_control' [pweight = risk_adj_sample_wgt], absorb(`reg_fe') vce(cl cluster_adm1yymm)"
{txt} 22{com}. qui reghdfe mins_worked `reg_treatment' `reg_control' [pweight = risk_adj_sample_wgt], absorb(`reg_fe') vce(cl cluster_adm1yymm)
{txt} 23{com}. estimates notes: "`spec_desc'"
{txt} 24{com}. estimates save "`ster_name'", replace
{txt} 25{com}. 
. {c )-}
{txt} 26{com}. {c )-}
