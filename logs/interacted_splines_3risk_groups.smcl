{txt}162{com}. gen tmax_rcspl_3kn_t1_hrnoag_lr_v2 = tmax_rcspl_3kn_t1_v2 * hr_noag * lr_tmax_p1
{txt}163{com}. gen tmax_rcspl_3kn_t1_hrnoag_lr_v3 = tmax_rcspl_3kn_t1_v3 * hr_noag * lr_tmax_p1
{txt}164{com}. gen tmax_rcspl_3kn_t1_hrnoag_lr_v4 = tmax_rcspl_3kn_t1_v4 * hr_noag * lr_tmax_p1
{txt}165{com}. gen tmax_rcspl_3kn_t1_hrnoag_lr_v5 = tmax_rcspl_3kn_t1_v5 * hr_noag * lr_tmax_p1
{txt}166{com}. gen tmax_rcspl_3kn_t1_hrnoag_lr_v6 = tmax_rcspl_3kn_t1_v6 * hr_noag * lr_tmax_p1
{txt}167{com}. {c )-}
{txt}168{com}. di "Created HR_NOAG interactions"
{txt}169{com}. 
. *** ===================================================
. *** CONTROLS: Extract and interact (keep missing precip values)
. *** ===================================================
. local control_list "${c -(}usual_controls{c )-}"
{txt}170{com}. local control_list : subinstr local control_list "c." "", all
{txt}171{com}. 
. di "Creating control interactions (keeping precipitation missing values)..."
{txt}172{com}. quietly {c -(}
{txt}173{com}. foreach var in `control_list' {c -(}
{txt}174{com}. capture confirm variable `var'
{txt}175{com}. if _rc == 0 {c -(}
{txt}176{com}. * Create interactions - missing values will naturally propagate
. gen `var'_low = `var' * low_risk
{txt}177{com}. gen `var'_hrag = `var' * hr_ag  
{txt}178{com}. gen `var'_hrnoag = `var' * hr_noag
{txt}179{com}. {c )-}
{txt}180{com}. {c )-}
{txt}181{com}. {c )-}
{txt}182{com}. di "Created control interactions"
{txt}183{com}. 
. *** ===================================================
. *** Define regression components
. *** ===================================================
. local reg_treatment tmax_rcspl_3kn_t0_low* tmax_rcspl_3kn_t1_low* tmax_rcspl_3kn_t0_hrag* tmax_rcspl_3kn_t1_hrag* tmax_rcspl_3kn_t0_hrnoag* tmax_rcspl_3kn_t1_hrnoag*
{txt}184{com}. 
. local reg_control ""
{txt}185{com}. foreach var in `control_list' {c -(}
{txt}186{com}. local reg_control `reg_control' `var'_low `var'_hrag `var'_hrnoag
{txt}187{com}. {c )-}
{txt}188{com}. 
. local reg_fe ""
{txt}189{com}. foreach f in $`fe' {c -(}
{txt}190{com}. local reg_fe `reg_fe' `f'#low_risk `f'#hr_ag `f'#hr_noag
{txt}191{com}. {c )-}
{txt}192{com}. 
. *** ===================================================
. *** Set file names and RUN
. *** ===================================================
. local ster_name "`reg_folder'/interacted_reg_`reg'_3risk_groups.ster"
{txt}193{com}. local spec_desc "rcspline, 3 knots (27 37 39), tmax, 3 risk groups (low, hr_ag, hr_noag), fe = $fe, reg_type = `reg'"
{txt}194{com}. loc weight "rep_unit_year_sample_wgt"
{txt}195{com}. 
. di "===================================================="
{txt}196{com}. di "Running regression..."
{txt}197{com}. di "===================================================="
{txt}198{com}. 
. reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)
{txt}199{com}. 
. *** ===================================================
. *** Save results
. *** ===================================================
. gen included = e(sample)
{txt}200{com}. count if included == 1 & risk3 == 1
{txt}201{com}. estadd scalar N_low = r(N)
{txt}202{com}. count if included == 1 & risk3 == 2
{txt}203{com}. estadd scalar N_hr_ag = r(N)
{txt}204{com}. count if included == 1 & risk3 == 3
{txt}205{com}. estadd scalar N_hr_noag = r(N)
{txt}206{com}. 
. estimates notes: "`spec_desc' representative unit-year weights"
{txt}207{com}. estimates save "`ster_name'", replace
{txt}208{com}. 
. di "===================================================="
{txt}209{com}. di "COMPLETED: `reg' regression with 3 risk groups."
{txt}210{com}. di "N_low_risk = " e(N_low)
{txt}211{com}. di "N_hr_ag = " e(N_hr_ag)
{txt}212{com}. di "N_hr_noag = " e(N_hr_noag)
{txt}213{com}. di "===================================================="
{txt}214{com}. {c )-}

