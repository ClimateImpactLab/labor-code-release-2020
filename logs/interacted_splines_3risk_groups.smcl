{com}. 
. * select dataset and output folder

. gl dataset "/project/cil/battuta_shares/gcp/estimation/labor/code_release_int_data/regression_ready_data/labor_dataset_splines_nochn_tmax_chn_prev_week_no_ll_0_3sector_agcoma.dta"

. loc reg_folder "${c -(}DIR_OUTPUT{c )-}/interacted_reg_output/ster"

. 
. * other selections

. gl test_code "no"

. gl reg_list 2_factor

. loc fe fe_adm0_wk

. 
. ********************

. *RUN REGRESSION

. ********************

. foreach reg in $reg_list {c -(}
{txt}  2{com}. 
. di "`reg_list'"
{txt}  3{com}. 
. use $dataset, clear
{txt}  4{com}. drop if iso == "GBR" & year == 1984 & month == 1 & day == 2
{txt}  5{com}. 
. *** ===================================================
. *** Define 3 risk groups
. *** ===================================================
. gen byte risk3 = .
{txt}  6{com}. replace risk3 = 1 if high_risk == 0
{txt}  7{com}. replace risk3 = 2 if high_risk3 == 1
{txt}  8{com}. replace risk3 = 3 if high_risk == 1 & high_risk3 != 1
{txt}  9{com}. label define risk3 1 "low" 2 "hr_ag" 3 "hr_noag"
{txt} 10{com}. label values risk3 risk3
{txt} 11{com}. drop if missing(risk3)
{txt} 12{com}. 
. * if test code mode is on, take a random sample
. if "${c -(}test_code{c )-}"=="yes" {c -(}
{txt} 13{com}. sample 0.1
{txt} 14{com}. {c )-}
{txt} 15{com}. 
. * only include non-zero observations
. keep if mins_worked > 0
{txt} 16{com}. 
. * get rid of some awkward naming
. rename *27_37_39_* **
{txt} 17{com}. 
. * generate regression variables
. gen_controls_and_FEs
{txt} 18{com}. gen_treatment_splines rcspl 3 tmax this_week 1
{txt} 19{com}. 
. *** ===================================================
. *** Drop ONLY critical missing values (NOT precipitation)
. *** ===================================================
. * Drop observations with missing lr_tmax_p1
. count if missing(lr_tmax_p1)
{txt} 20{com}. local n_missing_lr = r(N)
{txt} 21{com}. if `n_missing_lr' > 0 {c -(}
{txt} 22{com}. di in yellow "Dropping `n_missing_lr' observations with missing lr_tmax_p1"
{txt} 23{com}. drop if missing(lr_tmax_p1)
{txt} 24{com}. {c )-}
{txt} 25{com}. 
. * Drop observations with missing log_gdp_pc_adm1
. count if missing(log_gdp_pc_adm1)
{txt} 26{com}. local n_missing_gdp = r(N)
{txt} 27{com}. if `n_missing_gdp' > 0 {c -(}
{txt} 28{com}. di in yellow "Dropping `n_missing_gdp' observations with missing log_gdp_pc_adm1"
{txt} 29{com}. drop if missing(log_gdp_pc_adm1)
{txt} 30{com}. {c )-}
{txt} 31{com}. 
. * DO NOT drop precipitation missing values - they are natural (no rain)
. 
