{txt}133{com}.     count if included == 1 & risk_level == 1
{txt}134{com}.     estadd scalar high_N = `r(N)'
{txt}135{com}.     
.     estimates notes: "`spec_desc' representative unit-year weights"
{txt}136{com}.     estimates save "`ster_name'", replace
