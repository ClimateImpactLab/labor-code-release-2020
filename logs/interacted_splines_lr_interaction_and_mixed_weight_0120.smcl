{txt}128{com}.     di "reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)"
{txt}129{com}.     
.     reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], ///
