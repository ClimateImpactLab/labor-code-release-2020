{smcl}
{com}{sf}{ul off}{txt}{.-}
      name:  {res}<unnamed>
       {txt}log:  {res}/project/cil/home_dirs/maiqi/repos/labor-code-release-2020/logs/interacted_polynomials_lr_interaction_and_mixed_weight.smcl
  {txt}log type:  {res}smcl
 {txt}opened on:  {res}12 Dec 2025, 13:02:54

{com}. 
. *****************

. *  SETTINGS

. *****************

. 
. gl dataset      "/project/cil/battuta_shares/gcp/estimation/labor/code_release_int_data/regression_ready_data/labor_dataset_polynomials_nochn_tmax_chn_prev_week_no_ll_0.dta"

. loc reg_folder  "${c -(}DIR_OUTPUT{c )-}/interacted_reg_output/ster"

. 
. gl test_code "no"

. 
. * choose which regression type

. * 1_factor: no GDP and no LR interaction term (but still separate LR vs HR)

. * 2_factor: include HR*GDP and HR*LR interaction terms (like your spline 2_factor)

. gl reg_list 2_factor

. 
. * choose FE set

. loc fe fe_adm0_wk

. 
. * choose risk definition

. global risk_def "high_risk"

. 
. * choose polynomial order(s)

. * you can change to: local order_list 3   if you only want poly3

. local order_list 2 3 4

. 
. * choose weight variable (same as your spline code)

. local weight "rep_unit_year_sample_wgt"

. 
. ****************************************

. *  RUN REGRESSION

. ****************************************

. 
. foreach reg in $reg_list {c -(}
{txt}  2{com}. 
.     foreach N_order of local order_list {c -(}
{txt}  3{com}. 
.         use "$dataset", clear
{txt}  4{com}. 
.         * drop known bad obs (keep if you still need this)
.         cap drop iso
{txt}  5{com}.         * if iso exists in this dataset, keep the original line:
.         cap confirm variable iso
{txt}  6{com}.         if _rc==0 {c -(}
{txt}  7{com}.             drop if iso == "GBR" & year == 1984 & month == 1 & day == 2
{txt}  8{com}.         {c )-}
{txt}  9{com}. 
.         if "${c -(}test_code{c )-}"=="yes" {c -(}
{txt} 10{com}.             sample 0.1
{txt} 11{com}.         {c )-}
{txt} 12{com}. 
.         keep if mins_worked > 0
{txt} 13{com}. 
.         *****************
.         *  PREP
.         *****************
. 
.         gen_controls_and_FEs
{txt} 14{com}. 
.         * this generates polynomial vars and fills globals such as ${c -(}vars_T_polynomials{c )-}
.         * N_order controls how many powers are included (p1..pN)
.         gen_treatment_polynomials `N_order' tmax this_week 1
{txt} 15{com}. 
.         *****************
.         *  DEFINE risk_level FROM CHOSEN SOURCE
.         *****************
. 
.         cap drop risk_level
{txt} 16{com}.         gen risk_level = .
{txt} 17{com}. 
.         replace risk_level = high_risk_old if "${c -(}risk_def{c )-}"=="high_risk_old"
{txt} 18{com}.         replace risk_level = high_risk     if "${c -(}risk_def{c )-}"=="high_risk"
{txt} 19{com}.         replace risk_level = sector        if "${c -(}risk_def{c )-}"=="sector"
{txt} 20{com}.         replace risk_level = occup_code    if "${c -(}risk_def{c )-}"=="occup_code"
{txt} 21{com}. 
.         * This LR/HR split assumes binary risk_level (0/1)
.         * If you pass sector/occup_code (multi-category), stop here and adapt logic below
.         cap assert inlist(risk_level,0,1) if risk_level<.
{txt} 22{com}.         if _rc!=0 {c -(}
{txt} 23{com}.             di as error "risk_level is not binary (0/1). The LR/HR construction below assumes binary risk_level."
{txt} 24{com}.             exit 198
{txt} 25{com}.         {c )-}
{txt} 26{com}. 
.         cap drop low_risk
{txt} 27{com}.         gen low_risk = 1 - risk_level
{txt} 28{com}. 
.         *****************
.         *  BUILD LR/HR TERMS EXPLICITLY (LIKE YOUR SPLINE SCRIPT)
.         *****************
. 
.         * We assume gen_treatment_polynomials created:
.         *   tmax_p1 ... tmax_pN
.         *   and (for this_week) tmax_p#_v1 ... tmax_p#_v6
.         local lag_suffix_list "" "_v1" "_v2" "_v3" "_v4" "_v5" "_v6"
{txt} 29{com}. 
.         forval p = 1/`N_order' {c -(}
{txt} 30{com}. 
.             foreach sfx of local lag_suffix_list {c -(}
{txt} 31{com}. 
.                 * safety: only generate if the base var exists
.                 cap confirm variable tmax_p`p'`sfx'
{txt} 32{com}.                 if _rc==0 {c -(}
{txt} 33{com}. 
.                     cap drop tmax_p`p'_lr`sfx'
{txt} 34{com}.                     gen      tmax_p`p'_lr`sfx' = tmax_p`p'`sfx' * low_risk
{txt} 35{com}. 
.                     cap drop tmax_p`p'_hr`sfx'
{txt} 36{com}.                     gen      tmax_p`p'_hr`sfx' = tmax_p`p'`sfx' * risk_level
{txt} 37{com}. 
.                     * HR * GDP interaction term (2_factor)
.                     cap drop tmax_p`p'_hr_g`sfx'
{txt} 38{com}.                     gen      tmax_p`p'_hr_g`sfx' = tmax_p`p'`sfx' * risk_level * log_gdp_pc_adm1
{txt} 39{com}. 
.                     * HR * LR interaction term (2_factor)
.                     * assumes lr_tmax_p1 exists (it should if your spline code used it)
.                     cap confirm variable lr_tmax_p1
{txt} 40{com}.                     if _rc==0 {c -(}
{txt} 41{com}.                         cap drop tmax_p`p'_hr_lr`sfx'
{txt} 42{com}.                         gen      tmax_p`p'_hr_lr`sfx' = tmax_p`p'`sfx' * risk_level * lr_tmax_p1
{txt} 43{com}.                     {c )-}
{txt} 44{com}.                 {c )-}
{txt} 45{com}.             {c )-}
{txt} 46{com}.         {c )-}
{txt} 47{com}. 
.         *****************
.         *  TREATMENT SPEC
.         *****************
. 
.         local reg_treatment ""
{txt} 48{com}. 
.         if "`reg'" == "1_factor" {c -(}
{txt} 49{com}.             * separate LR and HR polynomial responses
.             local reg_treatment tmax_p*_lr* tmax_p*_hr*
{txt} 50{com}.         {c )-}
{txt} 51{com}.         else if "`reg'" == "2_factor" {c -(}
{txt} 52{com}.             * add HR*GDP and HR*LR interaction terms
.             * (LR group still comes from explicit *_lr* terms)
.             local reg_treatment tmax_p*_lr* tmax_p*_hr* tmax_p*_hr_g* tmax_p*_hr_lr*
{txt} 53{com}.         {c )-}
{txt} 54{com}.         else {c -(}
{txt} 55{com}.             di as error "bad reg specification -> pick '1_factor' or '2_factor'"
{txt} 56{com}.             exit 198
{txt} 57{com}.         {c )-}
{txt} 58{com}. 
.         *****************
.         *  CONTROLS AND FE
.         *****************
. 
.         local reg_control (${c -(}usual_controls{c )-})##i.risk_level
{txt} 59{com}. 
.         local reg_fe ""
{txt} 60{com}.         foreach f in $`fe' {c -(}
{txt} 61{com}.             local reg_fe `reg_fe' `f'#risk_level
{txt} 62{com}.         {c )-}
{txt} 63{com}. 
.         *****************
.         *  SAVE OUTPUT
.         *****************
. 
.         cap mkdir "`reg_folder'"
{txt} 64{com}. 
.         local ster_name "`reg_folder'/interacted_poly_`reg'_order`N_order'_`=lower("${c -(}risk_def{c )-}")'_2025.ster"
{txt} 65{com}.         local spec_desc "polynomial, order=`N_order', tmax, explicit LR/HR terms, fe=`fe', reg_type=`reg', risk_def=${c -(}risk_def{c )-}, weight=`weight'"
{txt} 66{com}. 
.         di "reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)"
{txt} 67{com}.         reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)
{txt} 68{com}. 
.         * counts by risk
.         cap drop included
{txt} 69{com}.         gen included = e(sample)
{txt} 70{com}. 
.         count if included == 1 & risk_level == 0
{txt} 71{com}.         estadd scalar low_N = `r(N)'
{txt} 72{com}. 
.         count if included == 1 & risk_level == 1
{txt} 73{com}.         estadd scalar high_N = `r(N)'
{txt} 74{com}. 
.         estimates notes: "`spec_desc'"
{txt} 75{com}.         estimates save "`ster_name'", replace
{txt} 76{com}. 
.         di "COMPLETED: `reg' regression, poly order = `N_order'."
{txt} 77{com}.     {c )-}
{txt} 78{com}. {c )-}
