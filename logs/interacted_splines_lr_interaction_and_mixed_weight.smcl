{txt}  2{com}. 
.         di "`reg_list'"
{txt}  3{com}. 
.         use $dataset, clear
{txt}  4{com}.         drop if iso == "GBR" & year == 1984 & month == 1 & day == 2
{txt}  5{com}. 
