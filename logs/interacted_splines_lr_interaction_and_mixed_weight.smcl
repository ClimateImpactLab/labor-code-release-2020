.         if "`reg'" == "1_factor" loc reg_treatment tmax_rcspl_3kn_t0_lr* tmax_rcspl_3kn_t1_lr*  tmax_rcspl_3kn_t0_hr* tmax_rcspl_3kn_t1_hr*
{txt} 56{com}.         
.         *** This will give you un-useable estimate for LR
.         *if "`reg'" == "1_factor" loc reg_treatment (${c -(}vars_T_splines{c )-} ${c -(}vars_T_x_gdp_splines{c )-})##i.high_risk
.   
.         
.         else if "`reg'" == "2_factor" loc reg_treatment (${c -(}vars_T_splines{c )-} ${c -(}vars_T_x_gdp_splines{c )-} ${c -(}vars_T_x_lr_tmax_splines{c )-})##i.high_risk
{txt} 57{com}.         else di in red "bad reg specification -> pick '1 factor' or '2 factor'"
{txt} 58{com}.         di "`reg_treatment'"
{txt} 59{com}. 
.         * both regressions have interacted controls
.         local reg_control (${c -(}usual_controls{c )-})##i.high_risk
{txt} 60{com}.         di "`reg_control'"
{txt} 61{com}.         
.         * interact each fixed effect with the risk binary
.         local reg_fe ""                                 
{txt} 62{com}.         foreach f in $`fe' {c -(}
{txt} 63{com}.                 local reg_fe `reg_fe' `f'#high_risk
{txt} 64{com}.         {c )-}
{txt} 65{com}. 
.         * set the ster file name and the notes to be included
.         local ster_name "`reg_folder'/interacted_reg_`reg'_2025.ster"
{txt} 66{com}.         local spec_desc "rcspline, 3 knots (27 37 39), tmax, differentiated treatment withlr interaction, fe = $fe, reg_type = `reg'"
{txt} 67{com}. 
.         * set the regression weight
.         replace risk_adj_sample_wgt = rep_unit_year_sample_wgt if high_risk ==1
{txt} 68{com}.         loc weight "risk_adj_sample_wgt"
{txt} 69{com}. 
.         di "reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)"
{txt} 70{com}.         reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)
{txt} 71{com}. 
.         * count regression N by risk
.         gen included = e(sample)
{txt} 72{com}.         count if included == 1 & high_risk == 1
{txt} 73{com}.         estadd scalar high_N = `r(N)'
{txt} 74{com}.         count if included == 1 & high_risk == 0
{txt} 75{com}.         estadd scalar low_N = `r(N)'
{txt} 76{com}. 
.         estimates notes: "`spec_desc' representative unit-year weights" // or: "mixed weights (representative unit-year for high-risk, risk_adj for low-risk)"
{txt} 77{com}.         estimates save "`ster_name'", replace
{txt} 78{com}. 
.         di "COMPLETED: `reg' regression."
{txt} 79{com}. 
. {c )-}

