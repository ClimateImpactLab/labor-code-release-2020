.         gen included = e(sample)
{txt} 71{com}.         count if included == 1 & high_risk == 1
{txt} 72{com}.         estadd scalar high_N = `r(N)'
{txt} 73{com}.         count if included == 1 & high_risk == 0
{txt} 74{com}.         estadd scalar low_N = `r(N)'
{txt} 75{com}. 
.         estimates notes: "`spec_desc' representative unit-year weights" // or: "mixed weights (representative unit-year for high-risk, risk_adj for low-risk)"
{txt} 76{com}.         estimates save "`ster_name'", replace
{txt} 77{com}. 
.         di "COMPLETED: `reg' regression."
{txt} 78{com}. 
