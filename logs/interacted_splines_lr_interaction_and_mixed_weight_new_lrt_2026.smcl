{txt} 80{com}.     count if included == 1 & risk_level == 0
{txt} 81{com}.     estadd scalar low_N = `r(N)'
{txt} 82{com}.     count if included == 1 & risk_level == 1
{txt} 83{com}.     estadd scalar high_N = `r(N)'
{txt} 84{com}.  *   count if included == 1 & risk_level == 2
.   *  estadd scalar nonag_N = `r(N)'
. 
.     estimates notes: "`spec_desc' representative unit-year weights"
{txt} 85{com}.     estimates save "`ster_name'", replace
{txt} 86{com}. 
.     di "COMPLETED: `reg' regression."
{txt} 87{com}. 
