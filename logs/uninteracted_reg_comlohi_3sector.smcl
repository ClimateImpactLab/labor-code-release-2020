{smcl}
{com}{sf}{ul off}{txt}{.-}
      name:  {res}<unnamed>
       {txt}log:  {res}/project/cil/home_dirs/maiqi/repos/labor-code-release-2020/logs/uninteracted_reg_comlohi_3sector.smcl
  {txt}log type:  {res}smcl
 {txt}opened on:  {res}20 Jan 2026, 11:27:33
{txt}
{com}. 
. * select dataset and output folder
. gl dataset      "/project/cil/battuta_shares/gcp/estimation/labor/code_release_int_data/regression_ready_data/labor_dataset_splines_nochn_tmax_chn_prev_week_no_ll_0_agnonag_272841.dta"
{txt}
{com}. loc reg_folder  "${c -(}DIR_STER{c )-}/uninteracted_reg_comlohi"
{txt}
{com}. 
. * other selections
. gl test_code "no"
{txt}
{com}. gl reg_list by_risk common
{txt}
{com}. loc fe fe_adm0_wk
{txt}
{com}. 
. * ---------- CHOOSE WHICH RISK DEFINITION TO USE ----------
. * options: "high_risk" or "high_risk_old"
. global risk_def "sector" 
{txt}
{com}. * ---------------------------------------------------------
. 
. ********************
. *  RUN REGRESSION
. ********************
. 
. * cycle through each of the two regressions
. foreach reg in $reg_list {c -(}
{txt}  2{com}. 
.     di "`reg_list'"
{txt}  3{com}. 
.     use $dataset, clear
{txt}  4{com}. 
.     * if test code mode is on, take a random sample
.     if "${c -(}test_code{c )-}"=="yes" {c -(}
{txt}  5{com}.         sample 0.1
{txt}  6{com}.     {c )-}
{txt}  7{com}. 
.     * only include non-zero observations
.     keep if mins_worked > 0
{txt}  8{com}. 
.     * get rid of some awkward naming
.     rename *27_28_41_* ** 
{txt}  9{com}. 
.     * ---------- DEFINE risk_level FROM CHOSEN SOURCE ----------
.     cap drop risk_level 
{txt} 10{com}.     gen risk_level = .   
{txt} 11{com}.     replace risk_level = high_risk     if "${c -(}risk_def{c )-}"=="high_risk"
{txt} 12{com}.     replace risk_level = high_risk_old if "${c -(}risk_def{c )-}"=="high_risk_old"
{txt} 13{com}.     replace risk_level = sector if "${c -(}risk_def{c )-}"=="sector"
{txt} 14{com}.     replace risk_level = occup_code if "${c -(}risk_def{c )-}"=="occup_code"
{txt} 15{com}. 
.     * generate regression variables
.     gen_controls_and_FEs
{txt} 16{com}.     gen_treatment_splines rcspl 3 tmax this_week 1
{txt} 17{com}. 
.     * differentiate treatment if reg is by risk
.     if "`reg'" == "by_risk" loc reg_treatment (${c -(}vars_T_splines{c )-})##i.risk_level 
{txt} 18{com}.     else if "`reg'" == "common" loc reg_treatment (${c -(}vars_T_splines{c )-})
{txt} 19{com}.     else di in red "bad reg specification -> pick 'common' or 'by_risk'"
{txt} 20{com}.     di "`reg_treatment'"
{txt} 21{com}. 
.     * both regressions have interacted controls
.     local reg_control (${c -(}usual_controls{c )-})##i.risk_level    
{txt} 22{com}.     di "`reg_control'"
{txt} 23{com}.     
.     * interact each fixed effect with the risk binary
.     local reg_fe ""                    
{txt} 24{com}.     foreach f in $`fe' {c -(}
{txt} 25{com}.         local reg_fe `reg_fe' `f'#risk_level         
{txt} 26{com}.     {c )-}
{txt} 27{com}. * -------------------------------------------------------------------------------------------------------
.     * set the ster file name and the notes to be included
.     local ster_name "`reg_folder'/uninteracted_reg_`reg'_2025_272841_sector.ster"
{txt} 28{com}.     local spec_desc "rcspline, 3 knots (27 28 41), tmax, differentiated treatment, fe = $fe, reg_type = `reg'"
{txt} 29{com}.     
. * -------------------------------------------------------------------------------------------------------
.     * set the regression weight (pop_adj for common, risk_adj for by-risk)
.     if "`reg'" == "common" loc weight "pop_adj_sample_wgt"
{txt} 30{com}.     else loc weight "risk_adj_sample_wgt_sector"
{txt} 31{com}. 
.     di "reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)"
{txt} 32{com}.     reghdfe mins_worked `reg_treatment' `reg_control' [pweight = `weight'], absorb(`reg_fe') vce(cl cluster_adm1yymm)
{txt} 33{com}. 
.     * count regression N by risk
.     gen included = e(sample)
{txt} 34{com}.     count if included == 1 & risk_level == 1       
{txt} 35{com}.     estadd scalar ag_N = `r(N)'
{txt} 36{com}.     count if included == 1 & risk_level == 0      
{txt} 37{com}.     estadd scalar low_N = `r(N)'
{txt} 38{com}.     count if included == 1 & risk_level == 2
{txt} 39{com}.     estadd scalar nonag_N = `r(N)'
{txt} 40{com}. 
.     estimates notes: "`spec_desc'"
{txt} 41{com}.     estimates save "`ster_name'", replace
{txt} 42{com}. 
.     di "COMPLETED: `reg' regression."
{txt} 43{com}. 
. {c )-}

